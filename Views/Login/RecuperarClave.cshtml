@{
    Layout = null;
}
@using CemSys2.ViewModel.Login
@model CambiarClaveLoginVM

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Login CemSys</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="~/fotos/cemsysss.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">


    <style>
        body {
            margin: 0;
            padding: 0;
            background: url('@Url.Content("~/fotos/fondo1.jpg")') center center no-repeat;
            background-size: cover;
            min-height: 100vh;
            position: relative;
        }

        .overlay {
            background-color: rgba(156, 224, 219, 0.4); /* #9ce0db con transparencia */
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }

        .contenido {
            position: relative;
            z-index: 1;
        }

        .card-login {
            width: 100%;
            max-width: 340px;
            padding: 2rem;
            font-size: 1.1rem;
        }

            .card-login h3 {
                font-size: 1.5rem;
            }

            .card-login p {
                font-size: 1rem;
            }

            .card-login img {
                max-height: 500px;
            }

        .btn-ingresar {
            background-color: #338b85;
            color: #ffffff;
            border: none;
            padding: 10px 20px;
            font-size: 1.1rem;
            border-radius: 5px;
            cursor: pointer;
            width: 270px;
            display: block;
            text-align: center;
            margin-left: auto;
            margin-right: auto;
        }

            .btn-ingresar:hover {
                background-color: #287a6c;
            }
    </style>
</head>
<body>
    <div class="overlay"></div>

    <div class="contenido">
        <div class="container d-flex align-items-center justify-content-center min-vh-100">
            <div class="card shadow-lg card-login">
                <div class="text-center mb-4">
                    <img src="~/fotos/cemsysss.png" class="img-fluid mx-auto d-block" alt="Logo" />
                </div>

                <form id="form-recuperacion" asp-action="RecuperarClave" method="post">

                    <div class="mb-3">
                        <label class="form-label" for="nombre">Clave nueva</label>
                        <div class="input-group">
                            <input class="form-control" type="password" id="password" asp-for="ClaveNueva" required maxlength="300" />
                            <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                <i class="bi bi-eye" id="iconPassword"></i>
                            </button>
                        </div>
                        <span asp-validation-for="ClaveNueva" class="text-danger"></span>
                    </div>
                    <div class="d-grid">
                        <input type="hidden" asp-for="Correo" value="@Model.Correo" />
                        <button type="submit" id="btnEnviar" class="btn-ingresar">Cambiar contraseña</button>
                    </div>
                </form>
                <br />
                <div class="text-center">
                    <a asp-action="Index" asp-controller="Login">Volver</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />


    <script>
        // Cuando se envía el formulario
        document.getElementById('form-recuperacion').addEventListener('submit', function (event) {
            const btn = document.getElementById('btnEnviar');
            const form = this;

            // Verificar validación usando jQuery Validation
            if ($(form).valid()) {
                // Solo mostrar spinner si la validación pasa
                btn.disabled = true;
                btn.innerHTML = `
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    Enviando...
                `;
            }
            // Si no es válido, dejar que el navegador muestre los errores normalmente
        });

        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('togglePassword').addEventListener('click', function () {
                const passwordInput = document.getElementById('password');
                const icon = document.getElementById('iconPassword');

                const isPassword = passwordInput.type === 'password';
                passwordInput.type = isPassword ? 'text' : 'password';

                // Cambiar ícono
                icon.classList.toggle('bi-eye');
                icon.classList.toggle('bi-eye-slash');
            });

        });
        
    </script>
    <script>
        // Mostrar SweetAlert cuando la página se carga
        document.addEventListener('DOMContentLoaded', function() {
            // Verificar si hay mensaje de SweetAlert desde el servidor
            var alertType = '@(TempData["SweetAlertType"] ?? "")';
            if (alertType) {
                Swal.fire({
                    icon: alertType,
                    title: '@Html.Raw(TempData["SweetAlertTitle"] ?? "")',
                    text: '@Html.Raw(TempData["SweetAlertMessage"] ?? "")',
                    confirmButtonText: 'Aceptar',
                    confirmButtonColor: '#3085d6'
                });
            }
        });
    </script>
</body>
</html>
