@{
    Layout = null;
}
@using CemSys2.ViewModel.Login
@model CorreoRecuperacionVM

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Login CemSys</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="~/fotos/cemsysss.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">


    <style>
        body {
            margin: 0;
            padding: 0;
            background: url('@Url.Content("~/fotos/fondo1.jpg")') center center no-repeat;
            background-size: cover;
            min-height: 100vh;
            position: relative;
        }

        .overlay {
            background-color: rgba(156, 224, 219, 0.4); /* #9ce0db con transparencia */
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }

        .contenido {
            position: relative;
            z-index: 1;
        }

        .card-login {
            width: 100%;
            max-width: 340px;
            padding: 2rem;
            font-size: 1.1rem;
        }

            .card-login h3 {
                font-size: 1.5rem;
            }

            .card-login p {
                font-size: 1rem;
            }

            .card-login img {
                max-height: 500px;
            }

        .btn-ingresar {
            background-color: #338b85;
            color: #ffffff;
            border: none;
            padding: 10px 20px;
            font-size: 1.1rem;
            border-radius: 5px;
            cursor: pointer;
            width: 270px;
            display: block;
            text-align: center;
            margin-left: auto;
            margin-right: auto;
        }

            .btn-ingresar:hover {
                background-color: #287a6c;
            }
    </style>
</head>
<body>
    <div class="overlay"></div>

    <div class="contenido">
        <div class="container d-flex align-items-center justify-content-center min-vh-100">
            <div class="card shadow-lg card-login">
                <div class="text-center mb-4">
                    <img src="~/fotos/cemsysss.png" class="img-fluid mx-auto d-block" alt="Logo" />
                </div>

                @if (!string.IsNullOrEmpty(Model?.MensajeError)) //si mensaje es distinto de null
                {
                    <div class="alert alert-danger">@Model.MensajeError</div>
                }

                <form id="form-recuperacion" asp-action="EnviarCorreoRecuperacion" method="post">
                    <div class="mb-3">
                        <label for="correo" class="form-label">Ingrese su correo electrónico</label>
                        <input type="email" class="form-control" id="correo" asp-for="correo" required>
                        <span asp-validation-for="correo" class="text-danger"></span>
                    </div>
                    <div class="d-grid">
                        <button type="submit" id="btnEnviar" class="btn-ingresar">Enviar</button>
                    </div>
                </form>
                <br />
                <div class="text-center">
                    <a asp-action="Index" asp-controller="Login">Volver</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />


    <script>
        // Cuando se envía el formulario
        document.getElementById('form-recuperacion').addEventListener('submit', function (event) {
            const btn = document.getElementById('btnEnviar');
            const form = this;

            // Verificar validación usando jQuery Validation
            if ($(form).valid()) {
                // Solo mostrar spinner si la validación pasa
                btn.disabled = true;
                btn.innerHTML = `
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                    Enviando...
                `;
            }
            // Si no es válido, dejar que el navegador muestre los errores normalmente
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            @if (TempData["CorreoStatus"] != null)
            {
                        var status = TempData["CorreoStatus"]?.ToString();
                        var mensaje = TempData["CorreoMensaje"]?.ToString();
                        var titulo = TempData["CorreoTitulo"]?.ToString();
                        if (status == "success")
                        {
                                    @:Swal.fire({
                                    @:    icon: 'success',
                                    @:    title: '@titulo',
                                    @:    text: '@mensaje',
                                    @:    confirmButtonColor: '#3085d6'
                                    @:});
                        }
                        else
                        {
                                    @:Swal.fire({
                                    @:    icon: 'error',
                                    @:    title: '@titulo',
                                    @:    text: '@mensaje',
                                    @:    confirmButtonColor: '#d33'
                                    @:});
                        }
            }
        });
    </script>
</body>
</html>
