@using CemSys2.ViewModel.Reportes
@model ConcesionesReportesVM
@{
    ViewData["Title"] = "Reporte de concesiones";
}
<h1 class="tituloDePagina">Reportes de concesiones</h1>

<!-- Buscador-->
<div class="accordion" id="accordionPanelsStayOpenExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button">
                Buscador
            </button>
        </h2>
        <div class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            <div class="accordion-body">
                <form asp-action="ReporteConcesiones" asp-controller="Reportes" method="get" id="frmBuscar">
                    @Html.AntiForgeryToken()

                    <div class="text-center p-3">
                        <label>Desde</label>
                        <input type="date" class="form-control-sm me-2" asp-for="FechaDesde" />
                        <label>Hasta</label>
                        <input type="date" class="form-control-sm me-2" asp-for="FechaHasta" />
                    </div>
                    <div class="text-center mt-3">
                        <button type="submit" class="btn btn-success me-2" id="btnBuscar">Buscar</button>
                        <a asp-action="VistaReportesConcesiones" asp-controller="Reportes" class="btn btn-primary" id="btnLimpiar">Limpiar filtros</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Contenedores de gráficos: dos categorías, apiladas verticalmente -->
@if(Model.ListaConcesiones.Count > 0)
{
    <div class="row">
        <div class="col-12 mb-5 contenedor-resumen" style="max-width: 1000px;">
            <div class="card p-3">
                <h3>Concesiones por fecha de generación</h3>
                <div class="d-flex gap-2 align-items-center mb-3">
                    <label>Tipo gráfico:</label>
                    <select id="concesionesChartType" class="form-control-sm">
                        <option value="barras">Barras</option>
                        <option value="torta">Torta</option>
                    </select>

                    <label>Frecuencia:</label>
                    <select id="concesionesFrecuencia" class="form-control-sm">
                        <option value="mes">Mes</option>
                        <option value="semana">Semana</option>
                        <option value="dia">Día</option>
                    </select>

                    <button id="btnActualizarConcesiones" class="btn btn-sm btn-primary">Aplicar filtros</button>
                    <button id="btnDescargarConcesiones" class="btn btn-sm btn-outline-secondary">Descargar</button>
                </div>

                <div id="concesionesChartWrapper" style="position:relative;">
                    <!-- wrapper para scroll horizontal -->
                    <div id="concesionesChart" style="overflow-x:auto; padding-bottom:10px;"></div>
                </div>
            </div>
        </div>

        <div class="col-12 mb-5 contenedor-resumen" style="max-width: 1000px;">
            <div class="card p-3">
                <h3>Concesiones por tiempo de concesión</h3>
                <div class="d-flex gap-2 align-items-center mb-3">
                    <label>Tipo gráfico:</label>
                    <select id="tiempoChartType" class="form-control-sm">
                        <option value="barras">Barras</option>
                        <option value="torta">Torta</option>
                    </select>

                    <label>Tipo Parcela:</label>
                    <select id="tipoParcelaFiltro" class="form-control-sm">
                        <option value="todos">Todos</option>
                        <option value="1">Nicho</option>
                        <option value="2">Fosa</option>
                    </select>

                    <button id="btnActualizarTiempo" class="btn btn-sm btn-primary">Aplicar filtros</button>
                    <button id="btnDescargarTiempo" class="btn btn-sm btn-outline-secondary">Descargar</button>
                </div>

                <div id="tiempoChartWrapper" style="position:relative; ">
                    <div id="tiempoChart" style="overflow-x:auto; padding-bottom:10px;"></div>
                </div>
            </div>
        </div>
    </div>
}

<!-- incluir d3.js -->
<script src="https://d3js.org/d3.v7.min.js"></script>
@section Scripts {
    <script>
        // serializamos la lista desde el servidor
        const rawData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.ListaConcesiones))

        // Helper: parse fechas de DTO (asume FechaGeneracion en formato ISO)
        rawData.forEach(r => r.FechaGeneracion = new Date(r.FechaGeneracion));

        // mapeo de cantidad años (Id -> label)
        const mapAnios = {
            1: "1 año",
            2: "5 años",
            3: "10 años",
            4: "15 años",
            5: "25 años"
        };

        // ---------- funciones de agrupación y cálculo ----------
        function agruparPorFrecuenciaConcesiones(data, frecuencia) {
            const groups = new Map();

            data.forEach(item => {
                const dt = new Date(item.FechaGeneracion);
                let sortKey, displayLabel;

                if (frecuencia === 'mes') {
                    sortKey = dt.getFullYear() + '-' + String(dt.getMonth() + 1).padStart(2, '0');
                    displayLabel = String(dt.getMonth() + 1).padStart(2, '0') + '-' + dt.getFullYear();
                } else if (frecuencia === 'semana') {
                    const onejan = new Date(dt.getFullYear(), 0, 1);
                    const days = Math.floor((dt - onejan) / (24 * 60 * 60 * 1000));
                    const week = Math.ceil((days + onejan.getDay() + 1) / 7);
                    sortKey = dt.getFullYear() + '-W' + String(week).padStart(2, '0');
                    displayLabel = 'W' + String(week).padStart(2, '0') + '-' + dt.getFullYear();
                } else { // dia
                    sortKey = dt.getFullYear() + '-' +
                             String(dt.getMonth() + 1).padStart(2, '0') + '-' +
                             String(dt.getDate()).padStart(2, '0');
                    displayLabel = String(dt.getDate()).padStart(2, '0') + '-' +
                                  String(dt.getMonth() + 1).padStart(2, '0') + '-' +
                                  dt.getFullYear();
                }

                groups.set(sortKey, {
                    display: displayLabel,
                    value: (groups.get(sortKey)?.value || 0) + 1
                });
            });

            return Array.from(groups.entries())
                .map(([sortKey, obj]) => ({
                    label: obj.display,
                    value: obj.value,
                    sortKey: sortKey
                }))
                .sort((a, b) => a.sortKey.localeCompare(b.sortKey));
        }

        function agruparPorTiempo(data, tipoParcelaFiltro) {
            // Filtra por tipoParcela si corresponde (si se envía tipoParcelaFiltro != 'todos')
            const filtered = data.filter(d => (tipoParcelaFiltro === 'todos') ? true : String(d.TipoParcelaId) === String(tipoParcelaFiltro));

            const groups = new Map();
            filtered.forEach(item => {
                // item.CantidadAniosId es el Id (1..5), mapAnios determina etiqueta
                const id = item.CantidadAniosId;
                const label = mapAnios[id] ?? `Id ${id}`;
                groups.set(label, (groups.get(label) || 0) + 1);
            });

            // Si querés asegurar que aparezcan todos los buckets (1,5,10,15,25) aunque tengan 0:
            const resultado = [];
            [1,2,3,4,5].forEach(id => {
                resultado.push({ label: mapAnios[id], value: groups.get(mapAnios[id]) || 0 });
            });
            return resultado;
        }

        // ---------- D3: draw bar chart (with transitions) ----------
        function drawBarChart(containerSelector, data, options = {}) {
            // options: widthPerBar, height, margin
            const widthPerBar = options.widthPerBar || 60;
            const margin = {top: 20, right: 20, bottom: 80, left: 60};
            const height = options.height || 400;
            const totalWidth = Math.max(600, data.length * widthPerBar);
            // limpiar contenedor
            const container = d3.select(containerSelector).html('');

            const svg = container.append('svg')
                .attr('width', totalWidth + margin.left + margin.right)
                .attr('height', height + margin.top + margin.bottom);

            const g = svg.append('g').attr('transform', `translate(${margin.left},${margin.top})`);

            const x = d3.scaleBand()
                .domain(data.map(d => d.label))
                .range([0, totalWidth])
                .padding(0.1);

            const y = d3.scaleLinear()
                .domain([0, d3.max(data, d => d.value) || 1])
                .nice()
                .range([height - margin.top - margin.bottom, 0]);

            // Eje Y
            g.append('g').call(d3.axisLeft(y));

            // Eje X (rotado)
            g.append('g')
                .attr('transform', `translate(0,${height - margin.top - margin.bottom})`)
                .call(d3.axisBottom(x))
                .selectAll("text")
                .attr("transform", "rotate(-45)")
                .style("text-anchor", "end")
                .style('font-size', '15px');  // <- tamaño de letra


            const color = d3.scaleOrdinal(d3.schemeCategory10);

            // barras iniciales con height=0 para animación
            const bars = g.selectAll('.bar')
                .data(data, d => d.label)
                .join('rect')
                .attr('class','bar')
                .attr('x', d => x(d.label))
                .attr('y', d => y(0))
                .attr('width', x.bandwidth())
                .attr('height', 0)
                .attr('fill', (d,i) => color(i));


            bars.transition()
                .duration(800)
                .delay((d, i) => i * 100)
                .ease(d3.easeElasticOut)
                .attr('y', d => y(d.value))
                .attr('height', d => (height - margin.top - margin.bottom) - y(d.value));

            // label en top de cada barra (opcional)
            g.selectAll('.bar-label')
                .data(data)
                .join('text')
                .attr('class','bar-label')
                .attr('x', d => x(d.label) + x.bandwidth()/2)
                .attr('y', d => y(d.value) - 6)
                .attr('text-anchor','middle')
                .text(d => d.value);

            // Dejar scroll horizontal si totalWidth excede contenedor
            // ya que svg tiene width totalWidth, el contenedor con overflow-x:auto permitirá scroll
        }

        // ---------- D3: draw pie chart ----------
        function drawPieChart(containerSelector, data, options = {}) {
            const width = options.width || 900;
            const height = options.height || 500;
            const radius = Math.min(width, height) / 2 - 40;

            const container = d3.select(containerSelector).html('');
            const svg = container.append('svg')
                .attr('width', width)
                .attr('height', height);

            // grupo centrado (dejamos espacio para la leyenda)
            const chartGroup = svg.append('g')
                .attr('transform', `translate(${width / 2 + 100},${height / 2})`);

            const pie = d3.pie().sort(null).value(d => d.value);
            const arcs = pie(data);

            const arc = d3.arc().innerRadius(0).outerRadius(radius);
            const outerArc = d3.arc().innerRadius(radius * 1.1).outerRadius(radius * 1.1);
            const color = d3.scaleOrdinal(d3.schemeCategory10);

            const total = d3.sum(data, d => d.value) || 1;

            const g = chartGroup.selectAll('.slice')
                .data(arcs)
                .join('g')
                .attr('class', 'slice');

            // animación de entrada de las porciones
            g.append('path')
                .attr('fill', (d, i) => color(i))
                .attr('d', arc)
                .attr('opacity', 0)
                .transition()
                .duration(600)
                .delay((d, i) => i * 120)
                .attr('opacity', 1)
                .attrTween('d', function(d) {
                    const i = d3.interpolate({ startAngle: d.startAngle, endAngle: d.startAngle }, d);
                    return t => arc(i(t));
                });

            if (data.length <= 7) {
                // etiquetas dentro si hay pocas porciones
                g.append('text')
                    .attr('transform', d => `translate(${arc.centroid(d)})`)
                    .attr('dy', '0.45em')
                    .attr('text-anchor', 'middle')
                    .style('font-size', '14px')
                    .style('opacity', 0)
                    .text(d => d3.format('.2%')(d.data.value / total))
                    .transition()
                    .delay(900)
                    .duration(500)
                    .style('opacity', 1);
            } else {
                // etiquetas exteriores si hay muchas porciones
                const polylines = g.append('polyline')
                    .attr('points', d => {
                        const posA = arc.centroid(d);
                        const posB = outerArc.centroid(d);
                        const posC = outerArc.centroid(d);
                        posC[0] = radius * 1.25 * (midAngle(d) < Math.PI ? 1 : -1);
                        return [posA, posB, posC];
                    })
                    .attr('stroke', (d, i) => color(i))
                    .attr('fill', 'none')
                    .attr('stroke-width', 1.5)
                    .attr('stroke-dasharray', function() {
                        const length = this.getTotalLength();
                        return `${length} ${length}`;
                    })
                    .attr('stroke-dashoffset', function() {
                        return this.getTotalLength();
                    })
                    .transition()
                    .delay((d, i) => 800 + i * 100)
                    .duration(700)
                    .attr('stroke-dashoffset', 0);

                const labels = g.append('text')
                    .attr('text-anchor', d => midAngle(d) < Math.PI ? 'start' : 'end')
                    .style('font-size', '14px')
                    .style('opacity', 0)
                    .text(d => d3.format('.2%')(d.data.value / total))
                    .each(function(d) {
                        d.pos = outerArc.centroid(d);
                        d.pos[0] = radius * 1.3 * (midAngle(d) < Math.PI ? 1 : -1);
                    })
                    .attr('transform', d => `translate(${d.pos})`)
                    .transition()
                    .delay((d, i) => 1300 + i * 100)
                    .duration(600)
                    .style('opacity', 1);

                // ---- evitar solapamiento vertical ----
                const spacing = 15; // espacio mínimo entre etiquetas
                const leftLabels = [];
                const rightLabels = [];

                labels.each(function(d) {
                    if (midAngle(d) < Math.PI) rightLabels.push(d);
                    else leftLabels.push(d);
                });

                adjustLabels(rightLabels, spacing, 1);
                adjustLabels(leftLabels, spacing, -1);

                // aplicar posiciones ajustadas
                labels.transition()
                    .delay(2000)
                    .duration(800)
                    .attr('transform', d => `translate(${d.pos})`);

                // actualizar líneas también
                polylines.transition()
                    .delay(2000)
                    .duration(800)
                    .attr('points', d => {
                        const posA = arc.centroid(d);
                        const posB = outerArc.centroid(d);
                        const posC = [radius * 1.25 * (midAngle(d) < Math.PI ? 1 : -1), d.pos[1]];
                        return [posA, posB, posC];
                    });
            }

            // función auxiliar: ángulo medio
            function midAngle(d) {
                return d.startAngle + (d.endAngle - d.startAngle) / 2;
            }

            // función para evitar superposición
            function adjustLabels(labelsArray, spacing, side) {
                labelsArray.sort((a, b) => a.pos[1] - b.pos[1]);
                for (let i = 1; i < labelsArray.length; i++) {
                    const prev = labelsArray[i - 1];
                    const curr = labelsArray[i];
                    if (curr.pos[1] - prev.pos[1] < spacing) {
                        curr.pos[1] = prev.pos[1] + spacing;
                    }
                }
                // opcional: mantener simetría lateral
                labelsArray.forEach(d => {
                    d.pos[0] = radius * 1.3 * side;
                });
            }

            // leyenda a la izquierda
            const legend = svg.append('g')
                .attr('transform', `translate(20, 40)`);

            const legendItems = legend.selectAll('.legend-item')
                .data(data)
                .join('g')
                .attr('class', 'legend-item')
                .attr('transform', (d, i) => `translate(0, ${i * 20})`);

            legendItems.append('rect')
                .attr('width', 12)
                .attr('height', 12)
                .attr('fill', (d, i) => color(i));

            legendItems.append('text')
                .attr('x', 22)
                .attr('y', 10)
                .style('font-size', '15px')
                .text(d => `${d.label} (${d.value})`);
        }

        // ---------- función para encontrar fechas reales en el conjunto filtrado ----------
        function encontrarFechasReales(data) {
            if (!data || data.length === 0) return { realDesde: null, realHasta: null };
            const sorted = data.slice().sort((a,b) => new Date(a.FechaGeneracion) - new Date(b.FechaGeneracion));
            return { realDesde: sorted[0].FechaGeneracion, realHasta: sorted[sorted.length-1].FechaGeneracion };
        }

        // ---------- helper: convertir dataURL a Blob ----------
        function dataURLtoBlob(dataurl) {
            const arr = dataurl.split(','), mime = arr[0].match(/:(.*?);/)[1],
                bstr = atob(arr[1]), n = bstr.length, u8arr = new Uint8Array(n);
            for (let i = 0; i < n; i++) u8arr[i] = bstr.charCodeAt(i);
            return new Blob([u8arr], {type:mime});
        }

        // ---------- exportar (convertir SVG a PNG) ----------
        async function exportSvgAsPng(svgElement, width, height) {
            const svgString = new XMLSerializer().serializeToString(svgElement);
            const svg64 = btoa(unescape(encodeURIComponent(svgString)));
            const b64Start = 'data:image/svg+xml;base64,';
            const image64 = b64Start + svg64;

            return new Promise((resolve, reject) => {
                const img = new Image();
                img.onload = () => {
                    const canvas = document.createElement('canvas');
                    canvas.width = width || img.width;
                    canvas.height = height || img.height;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0);
                    const png = canvas.toDataURL('image/png');
                    resolve(png);
                };
                img.onerror = e => reject(e);
                img.src = image64;
            });
        }

        // ---------- función para enviar descarga al controlador ----------
                // ---------- función para enviar descarga al controlador ----------
           async function enviarDescarga(pngDataUrl, realDesde, realHasta, categoria, chartType, frecuencia, tipoParcela) {
            try {
                console.log('Iniciando descarga...');

                // Extraer solo la parte base64 del data URL
                const imageBase64 = pngDataUrl.split(',')[1];

                // token antiforgery
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                // Crear un formulario temporal
                const tempForm = document.createElement('form');
                tempForm.method = 'POST';
                tempForm.action = '/Reportes/DescargarReporteConcesion';
                tempForm.style.display = 'none';

                // Función para agregar campos al formulario
                function addField(name, value) {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = name;
                    input.value = value;
                    tempForm.appendChild(input);
                }

                // Agregar todos los campos
                addField('imageBase64', imageBase64);
                if (realDesde) addField('realDesde', new Date(realDesde).toISOString());
                if (realHasta) addField('realHasta', new Date(realHasta).toISOString());
                addField('categoria', categoria ?? '');
                addField('chartType', chartType ?? '');
                addField('frecuencia', frecuencia ?? '');
                addField('tipoParcela', tipoParcela ?? '');

                if (token) {
                    addField('__RequestVerificationToken', token);
                    console.log('Token encontrado y agregado');
                }

                console.log('Enviando formulario con imagen Base64...');

                document.body.appendChild(tempForm);
                tempForm.submit();
                document.body.removeChild(tempForm);

            } catch (err) {
                console.error('Error completo:', err);
                alert('Error al enviar el reporte: ' + err.message);
            }
        }

        // ---------- wiring UI ----------
        function actualizarConcesiones() {
            let frecuencia = document.getElementById('concesionesFrecuencia');
            let chartType = document.getElementById('concesionesChartType');

            if(frecuencia){
                frecuencia = document.getElementById('concesionesFrecuencia').value;
            }

            if(chartType){
                chartType = document.getElementById('concesionesChartType').value;
            }

            const dataAgrupada = agruparPorFrecuenciaConcesiones(rawData, frecuencia);
            if (chartType === 'barras') {
                // dejamos ancho por barra proporcional (ej: 80)
                drawBarChart('#concesionesChart', dataAgrupada, { widthPerBar: 80, height: 420 });
            } else {
                // pie espera {label, value}; si hay muchas categorías quizá agrupar o tomar top N
                drawPieChart('#concesionesChart', dataAgrupada, { width: 600, height: 420 });
            }
        }

        function actualizarTiempo() {
            //const periodo = document.getElementById('tiempoFrecuencia').value; // '1','5',...
            const tipoPar = document.getElementById('tipoParcelaFiltro').value;
            const chartType = document.getElementById('tiempoChartType').value;

            // como los periodos son fijos, usamos agruparPorTiempo
            const dataAgrupada = agruparPorTiempo(rawData, tipoPar);

            if (chartType === 'barras') {
                drawBarChart('#tiempoChart', dataAgrupada, { widthPerBar: 140, height: 420 });
            } else {
                drawPieChart('#tiempoChart', dataAgrupada, { width: 600, height: 420 });
            }
        }
        const btnActualizarConcesiones = document.getElementById('btnActualizarConcesiones');
        if(btnActualizarConcesiones){
            btnActualizarConcesiones.addEventListener('click', (e) => {
                e.preventDefault();
                actualizarConcesiones();
            });
        }

        const btnActualizarTiempo = document.getElementById('btnActualizarTiempo');
        if(btnActualizarTiempo){
            btnActualizarTiempo.addEventListener('click', (e) => {
                e.preventDefault();
                actualizarTiempo();
            });
        }
        

        // Descarga concesiones
        const btnDescargarConcesiones = document.getElementById('btnDescargarConcesiones');
        if(btnDescargarConcesiones){
             btnDescargarConcesiones.addEventListener('click', async (e) => {
                e.preventDefault();
                // obtener SVG del contenedor (si existe)
                const wrapper = document.querySelector('#concesionesChart svg');
                if (!wrapper) { alert('No hay gráfico para descargar'); return; }
                const png = await exportSvgAsPng(wrapper, wrapper.getAttribute('width'), wrapper.getAttribute('height'));
                // fechas reales del rango actual: usar rawData filtrado por fecha (ya vino filtrado por servidor)
                const { realDesde, realHasta } = encontrarFechasReales(rawData);
                const frecuencia = document.getElementById('concesionesFrecuencia').value;
                const chartType = document.getElementById('concesionesChartType').value;

                await enviarDescarga(png, realDesde, realHasta, 'Concesiones por fecha de generación', chartType, frecuencia, '');
             });
        }
        

        // Descarga tiempo
        // Descarga tiempo - CORREGIDO
        const btnDescargarTiempo = document.getElementById('btnDescargarTiempo');
        if(btnDescargarTiempo){
            btnDescargarTiempo.addEventListener('click', async (e) => {
                e.preventDefault();
                const wrapper = document.querySelector('#tiempoChart svg');
                if (!wrapper) {
                    alert('No hay gráfico para descargar');
                    return;
                }

                try {
                    const png = await exportSvgAsPng(wrapper, wrapper.getAttribute('width'), wrapper.getAttribute('height'));
                    const { realDesde, realHasta } = encontrarFechasReales(rawData);
                    //const frecuencia = document.getElementById('tiempoFrecuencia').value;
                    const chartType = document.getElementById('tiempoChartType').value;
                    const tipoPar = document.getElementById('tipoParcelaFiltro').value;

                    await enviarDescarga(png, realDesde, realHasta, 'Concesiones por tiempo', chartType, '', tipoPar);
                } catch (error) {
                    console.error('Error al descargar:', error);
                    alert('Error al procesar la descarga: ' + error.message);
                }
            });
        }

        // inicializamos
        if(@Model.ListaConcesiones.Count > 0){
             actualizarConcesiones();
             actualizarTiempo();
        }
       

    </script>
}


