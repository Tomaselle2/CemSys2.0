@using CemSys2.ViewModel.Reportes
@model ConcesionesReportePDFVM
@{
    Layout = null;
    var cemsys = $"{Model.BaseUrl}/fotos/sinfondo2.png";
    var logoMuni = $"{Model.BaseUrl}/fotos/logoMuni.png";

}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Reporte</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            font-size: 12px;
            color: #333;
            margin: 0;
            padding: 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #333;
            padding-bottom: 15px;
        }

        .titulo {
            font-size: 24px;
            font-weight: bold;
            color: #2c3e50;
            margin-bottom: 10px;
        }

        .subtitulo {
            font-size: 16px;
            color: #7f8c8d;
            margin-bottom: 5px;
        }

        .info-section {
            margin-bottom: 20px;
            padding: 15px;
            background-color: #f8f9fa;
            border-radius: 5px;
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }

        .info-label {
            font-weight: bold;
            color: #2c3e50;
        }

        .info-value {
            color: #34495e;
        }

        .chart-container {
            text-align: center;
            margin: 20px 0;
            page-break-inside: avoid;
        }

        .chart-image {
            max-width: 95%;
            max-height: 500px; /* Altura máxima para evitar desborde */
            height: auto;
            border: 1px solid #ddd;
            border-radius: 5px;
            padding: 5px;
            background-color: white;
            object-fit: contain; /* Mantiene la proporción de la imagen */
        }

        .footer {
            margin-top: 50px;
            text-align: center;
            font-size: 10px;
            color: #7f8c8d;
            border-top: 1px solid #ddd;
            padding-top: 10px;
        }

        .fecha-generacion {
            text-align: right;
            margin-bottom: 20px;
            font-style: italic;
            color: #7f8c8d;
        }

        .footer img {
            width: 350px;
            margin-bottom: 1px;
        }

        .logo{
            width: 250px;
            margin-bottom: 5px;
        }

        .contenedor{
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 5px;
            box-sizing: border-box;
        }

        .page-content {
            min-height: calc(100vh - 200px); /* Asegura espacio para el contenido */
        }
        
    </style>
</head>
<body>
    <div class="page-content">
        <div class="fecha-generacion">
            Generado el: @Model.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")
        </div>
        <div class="contenedor">
            <div>
                <img class="logo" src="@logoMuni" alt="Logo municipalidad" />
            </div>
            <div>
                <img class="logo" src="@cemsys" alt="Logo municipalidad" />
            </div>
        </div>
        <div class="header">
            <div class="titulo">@Model.TituloReporte</div>
        </div>

        <div class="info-section">
            <div class="info-row">
                <span class="info-label">Categoría:</span>
                <span class="info-value">@Model.Categoria</span>
            </div>
            <div class="info-row">
                <span class="info-label">Tipo de Gráfico:</span>
                <span class="info-value">@Model.ChartType</span>
            </div>
            <div class="info-row">
                <span class="info-label">Frecuencia:</span>
                <span class="info-value">@Model.Frecuencia</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.TipoParcela))
            {
                <div class="info-row">
                    <span class="info-label">Tipo de Parcela:</span>
                    <span class="info-value">@Model.TipoParcela</span>
                </div>
            }
            <div class="info-row">
                <span class="info-label">Período:</span>
                <span class="info-value">@Model.RealDesde.ToString("dd/MM/yyyy") - @Model.RealHasta.ToString("dd/MM/yyyy")</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageBase64))
        {
            <div class="chart-container">
                <img src="data:image/png;base64,@Model.ImageBase64" alt="Gráfico del Reporte" class="chart-image" />
            </div>
        }
        else
        {
            <div class="chart-container">
                <p>No hay gráfico disponible para este reporte.</p>
            </div>
        }
    </div>
    
</body>
</html>