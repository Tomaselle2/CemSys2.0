                                        <div class="d-flex align-items-center gap-2">
                                            <!-- Botón para abrir modal de anular factura-->
                                            @if (estadoTramite != (int)EstadosIntroduccion.Finalizado
                                                && opc.EstadoId != (int)EstadosFactura.Cobrado
                                                && opc.EstadoId != (int)EstadosFactura.Anulado)
                                            {
                                                <button class="btn btn-danger anularFactura" type="button" data-facturaid="@opc.Id" title="Anular">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            }

                                            <button class="btn-historial" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasHistorialFactura"
                                                    data-facturaid="@opc.Id" title="Historial">
                                                <i class="bi bi-clock-history"></i>
                                            </button>
                                            <form asp-action="GenerarFactura" asp-controller="Cajero" method="get">
                                                <input type="hidden" name="facturaId" value="@opc.Id" />
                                                <button type="submit" class="btn btn-warning d-flex align-items-center gap-1">
                                                    <i class="bi bi-download"></i>
                                                </button>
                                            </form>
                                        </div>
                                        
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-info-circle"></i>
                        No hay facturas registradas.
                    </div>
                }

                <!-- Botón para abrir modal de ver recibo-->
                @* <button type="button"
                                                class="btn-modificar btn-sm"
                                                title="Ver"
                                                onclick="verRecibo('@opc.ArchivoId')">
                                            <i class="bi bi-eye"></i>
                                        </button> *@

                @* <button class="btn btn-primary btnEditarRecibo"
                                                    type="button"
                                                    data-id="@opc.Id"
                                                    data-concepto="@opc.Concepto"
                                                    data-archivo="@opc.Archivo?.NombreArchivo">
                                                <i class="bi bi-pencil"></i>
                                            </button> *@
                @* Fin cuerpo del acordeon *@
            </div>
        </div>
    </div>
</div>

