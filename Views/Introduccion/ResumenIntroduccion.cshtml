                @* cuerpo del acordion *@
                <table class="table table-hover mb-0">
                    <tr style="font-size: 1.2rem">
                        <td><b>Pendiente: $ @String.Format("{0:N2}", Model.ResumenIntroduccion[0].Pendiente)</b></td>
                    </tr>
                </table>
                @if (Model.ListaFacturas.Count > 0)
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Nro Factura</th>
                                <th>Fecha</th>
                                <th>Descripción</th>
                                <th>Importe</th>
                                <th>Contribuyente</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var opc in Model.ListaFacturas)
                            {
                                <tr>
                                    <td>@opc.Id</td>
                                    <td>@opc.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@opc.Descripcion</td>
                                    <td>$@String.Format("{0:N2}", opc.Total)</td>
                                    <td>@opc.NombreContribuyente?.ToUpper()</td>
