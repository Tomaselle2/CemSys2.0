@using CemSys2.ViewModel.Cajero
@model CobroExitosoVM

@{
    ViewData["Title"] = "Procesar factura";
    Layout = ""; // No usar layout general
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Login CemSys</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="~/fotos/cemsysss.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">


    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #81d497;
        }
    </style>
</head>
<body>
    <div>
        <img src="~/fotos/cemsysss.png" class="img-fluid mx-auto d-block" alt="Logo" />
    </div>
    <p>Cobro realizado exitosamente</p>
    <p>Ver recibo: factura: @Model.FacturaId</p>
    <form asp-controller="Cajero" asp-action="FacturasPendientes" method="get">
        <input type="submit"  value="Finalizar" class="btn btn-info" />
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>