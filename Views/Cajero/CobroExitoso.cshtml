@using CemSys2.ViewModel.Cajero
@model CobroExitosoVM

@{
    ViewData["Title"] = "Procesar factura";
    Layout = ""; // No usar layout general
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Login CemSys</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="~/fotos/cemsysss.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">


    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #C4FFD2;
            font-family: 'Montserrat', sans-serif;
        }

        .contenedor-principal {
            display: flex;
            flex-direction: column;
            justify-content: center; /* Centra verticalmente */
            align-items: center; /* Centra horizontalmente */
            min-height: 100vh; /* Ocupa todo el alto de la ventana */
            text-align: center;
        }

        .contenedor-botones {
            display: flex;
            gap: 1rem; /* Espacio entre los formularios */
            justify-content: center;
            margin-top: 1rem;
        }

        .contenedor-check{
            max-width: 400px;
        }

        .contenedor-logo {
            max-width: 300px;
        }

        .boton{
            padding: 10px;
            font-size: 1.2rem;
        }
    </style>
</head>
<body>
    <div class="contenedor-principal">
        
        <div class="contenedor-check" >
            <img src="~/fotos/Check.png" class="img-fluid mx-auto d-block" alt="Logo" />
        </div>
        <div>
            <h1><b>Cobro exitoso!</b></h1>
        </div>
        <div class="contenedor-botones">
            <div>
                <form asp-controller="Cajero" asp-action="GenerarFactura" method="get">
                    <input type="hidden" name="facturaId" value="@Model.FacturaId" />
                    <input type="submit" value="Ver factura" class="btn btn-info boton" />
                </form>
            </div>
            <div>
                <form asp-controller="Cajero" asp-action="FacturasPendientes" method="get">
                    <input type="submit" value="Finalizar" class="btn btn-dark boton" />
                </form>
            </div>
        </div> 
    </div>
   
    

    

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>