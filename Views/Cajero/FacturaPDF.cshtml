@using CemSys2.ViewModel.Cajero
@using CemSys2.Enumerable
@model FacturaPDF_VM

@{
    ViewData["Title"] = "Procesar factura";
    Layout = ""; // No usar layout general
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Login CemSys</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="~/fotos/cemsysss.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">


    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #C4aFD2;
            font-family: 'Montserrat', sans-serif;
        }
    </style>
</head>
<body>

    <h1>Factura</h1>
    <p>Factura Nro: @Model.Factura.Id</p>
    <p>Fecha: @Model.Factura.FechaCreacion.ToString("dd/MM/yyyy HH:mm") hs</p>
    <p>Estado: @(((EstadosFactura)Model.Factura.EstadoId.Value).GetDisplayName())</p>
    <p>Trámite Nro: @Model.Factura.TramiteId</p>
    <p>Tipo trámite: @EstadosEnum.ObtenerDisplayTipoTramite((TipotamiteEmun)Model.Factura.TipoTramiteId.Value)</p>

    <p>Contribuyente</p>
    <p>Nombre: @Model.Factura.Contribuyente?.Apellido.ToUpper() @Model.Factura.Contribuyente?.Nombre.ToUpper()</p>
    <p>DNI: @Model.Factura.Contribuyente?.Dni</p>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
