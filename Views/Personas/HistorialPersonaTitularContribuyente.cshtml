@using CemSys2.ViewModel
@using CemSys2.Enumerable
@model Persona_Historial_Contribuyente_Titular

@{
    ViewData["Title"] = "Historial persona";
}
@{
    string fecha = DateOnly.FromDateTime(DateTime.Now).ToString("yyyy-MM-dd");
    DateOnly fechaActual = DateOnly.FromDateTime(DateTime.Now);
    var fechaMax = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
}
<h1 class="tituloDePagina">Historial</h1>
@* Mostrar mensajes de éxito (desde TempData después de una redirección) *@
@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show alerta-contenedor" role="alert">
        @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* Mostrar mensajes de error genéricos (si los pones en model.MensajeError) *@
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show alerta-contenedor" role="alert">
        @Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<!-- Datos del titular -->
<div class="accordion" id="accordionDatosDifunto">
    @* ID único para el acordeón principal *@
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsDatosDifunto-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsDatosDifunto-collapseOne" aria-expanded="false" aria-controls="panelsDatosDifunto-collapseOne">
                Datos personales
            </button>
        </h2>
        <div id="panelsDatosDifunto-collapseOne" class="accordion-collapse  show" aria-labelledby="panelsDatosDifunto-headingOne" data-bs-parent="#accordionDatosDifunto">
            <div class="accordion-body">
                <div class="form-box">
                    <form asp-action="ModificarPersonaContribuyenteTitular" asp-controller="Personas" method="post">

                        <input type="hidden" asp-for="NN" />


                        <div class="form-columns-container3">
                            <div>
                                <label for="dni">DNI<span class="obligatorio" id="dniObligatorio"> * </span></label>
                                <input class="form-control" id="dniInput" type="text" asp-for="Dni" pattern="[0-9]+" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                                <span asp-validation-for="Dni" class="text-danger"></span>
                            </div>

                            <div>
                                <label for="nombreDifunto">Nombre<span class="obligatorio" id="nombreObligatorio"> * </span></label>
                                <input class="form-control" id="nombreInput" type="text" asp-for="Nombre" maxlength="60" minlength="2" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>

                            <div>
                                <label for="apellidoDifunto">Apellido<span class="obligatorio"> * </span></label>
                                <input class="form-control" type="text" id="apellidoInput" asp-for="Apellido" required maxlength="60" minlength="2" />
                                <span asp-validation-for="Apellido" class="text-danger"></span>
                            </div>


                            <div>
                                <label for="fechaNacimiento">Nacimiento</label>
                                <input class="form-control" type="date" asp-for="FechaNacimiento" max="@fecha" />
                                <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
                            </div>

                            <div>
                                <label for="sexoDifunto">Sexo<span class="obligatorio"> * </span></label>
                                <select class="form-select" asp-for="Sexo" required>
                                    <option value="">--Elija una opción--</option>
                                    <option value="masculino">Masculino</option>
                                    <option value="femenino">Femenino</option>
                                    <option value="otro">Otro</option>
                                </select>
                                <span asp-validation-for="Sexo" class="text-danger"></span>
                            </div>

                        </div>
                        <div class="form-columns-container3">
                            <div>
                                <label for="email">Correo</label>
                                <input class="form-control" type="email" asp-for="CorreoElectronico" maxlength="60" />
                                <span asp-validation-for="CorreoElectronico" class="text-danger"></span>
                            </div>
                            <div>
                                <label for="telefono">Teléfono</label>
                                <input class="form-control" type="text" asp-for="Celular" pattern="[0-9]+" oninput="this.value = this.value.replace(/[^0-9]/g, '')" maxlength="25" />
                                <span asp-validation-for="Celular" class="text-danger"></span>
                            </div>
                        </div>
                        <div>
                            <label for="domicilio">Domicilio</label>
                            <input class="form-control" type="text" asp-for="Domicilio" maxlength="100" />
                            <span asp-validation-for="Domicilio" class="text-danger"></span>
                        </div>
                        <!-- Datos adicionales -->
                        <div class="full-width my-2">
                            <label for="datosAdicionales">Datos adicionales</label>
                            <textarea class="form-control" asp-for="InformacionAdicional"></textarea>
                        </div>

                        <div style="display: flex; justify-content: center;">
                            <input type="hidden" asp-for="Id" />
                            <input type="submit" class="btn btn-success" value="Modificar" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Tabla de historial de tramites -->
<div class="accordion" id="accordionPanelsStayOpenExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                Historial de trámites (@Model.ListaHistorialTramites.Count())
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            @* cuerpo del acordion *@
            @if (Model.ListaHistorialTramites.Count != 0)
            {
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Nro trámite</th>
                                    <th>Fecha inicio</th>
                                    <th>Tipo de trámite</th>
                                    <th>Estado</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var opc in Model.ListaHistorialTramites)
                                {
                                    string fechaInicio = opc.FechaInicio.ToString("dd/MM/yyyy HH:mm");

                                    string tipoTramiteDisplay = EstadosEnum.ObtenerDisplayTipoTramite((TipotamiteEmun)opc.TipoTramite);
                                    string estadoTramiteDisplay = EstadosEnum.ObtenerNombreEstado((TipotamiteEmun)opc.TipoTramite, opc.EstadoTramite);

                                    <tr>
                                        <td>@opc.TramiteId.ToString()</td>
                                        <td>@fechaInicio</td>
                                        <td>@tipoTramiteDisplay</td>
                                        <td>@estadoTramiteDisplay</td>
                                        <td>
                                            <form asp-action="IrATramite" asp-controller="Tramite" target="_blank" method="get" style="display: inline-block;">
                                                <input type="hidden" name="tramiteId" value="@opc.TramiteId" />
                                                <button type="submit" class="btn-modificar btn-sm" title="Ir al trámite">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>

                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i>
                    No hay tramites registrados.
                </div>
            }
            @* Fin cuerpo del acordeon *@
        </div>
    </div>
</div>


<!--Tabla facturas emitidas -->
<div class="accordion" id="accordionPanelsStayOpenExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                Facturas
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            <div class="accordion-body" style="padding: 0">
                @* cuerpo del acordion *@
                @if (Model.ListaFacturas.Count > 0)
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Nro Factura</th>
                                <th>Fecha</th>
                                <th>Descripción</th>
                                <th>Importe</th>
                                <th>Contribuyente</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var opc in Model.ListaFacturas)
                            {
                                <tr>
                                    <td>@opc.Id</td>
                                    <td>@opc.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@opc.Descripcion</td>
                                    <td>$ @String.Format("{0:N2}", opc.Total)</td>
                                    <td>@opc.NombreContribuyente?.ToUpper()</td>
                                    <td>@(((EstadosFactura)opc.EstadoId.Value).GetDisplayName())</td>
                                    <td>
                                        <!-- Botón para abrir modal de ver recibo--> <!--Como aun no hay factura el btn no funiona--> 
                                        @* <button type="button"
                                                class="btnEditarRecibo btn-sm"
                                                title="Ver recibo"
                                                onclick="verRecibo('@opc.Id')">
                                            <i class="bi bi-receipt"></i>
                                        </button> *@
                                        <form asp-action="IrATramite" asp-controller="Tramite" target="_blank" method="get" style="display: inline-block;">
                                            <input type="hidden" name="tramiteId" value="@opc.TramiteId" />
                                            <button type="submit" class="btn-modificar btn-sm" title="Ir al trámite">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-info-circle"></i>
                        No hay facturas registradas.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!--Modal del visor de archivo -->
<div class="modal fade" id="modalVerRecibo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <!-- Extra grande -->
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Archivo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center" style="height: 85vh;">
                <iframe id="reciboViewer" style="width: 100%; height: 80vh; border: none; display: none;"></iframe>
                <img id="reciboImage" style="max-width: 100%; height: auto; display: none;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const dniInput = document.getElementById('dniInput');
        const nombreInput = document.getElementById('nombreInput');

        if (dniInput.value === "") dniInput.disabled = true;
        if (nombreInput.value === "") nombreInput.disabled = true;

    </script>

    <script>//ver el recivo/archivo
        function verRecibo(archivoId) {
            const iframe = document.getElementById("reciboViewer");
            const img = document.getElementById("reciboImage");

            // Ocultar ambos al principio
            iframe.style.display = "block";
            img.style.display = "none";

            iframe.src = `/Personas/VerRecibo?archivoId=${archivoId}`;

            new bootstrap.Modal(document.getElementById("modalVerRecibo")).show();
        }
    </script>
}


