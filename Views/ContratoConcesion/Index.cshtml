@using CemSys2.ViewModel.ContratoViewModel
@using CemSys2.Enumerable
@model IndexConcesionesVM
@{
    ViewData["Title"] = "Concesiones";
}

<h1 class="tituloDePagina">Concesiones</h1>
<!--Mostrar mensajes de error genéricos (si los pones en model.MensajeError) -->
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show alerta-contenedor" role="alert">
        @Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- tabla parcelas sin contrato-->
<div class="accordion" id="accordionSinContrato">
    <p>Debe esta finalizada la introducción para realizar el contrato de concesión</p>

    @* ID único para el acordeón principal *@
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsUbicacion-headingOne">
            <button class="accordion-button nueva-seccion" type="button" data-bs-toggle="collapse" data-bs-target="#panelsSinContrato-collapseOne" aria-expanded="false" aria-controls="panelsSinContrato-collapseOne">
                Parcelas sin contrato (@Model.ListaParcelasSinContrato.Count())
            </button>
        </h2>
        <div id="panelsSinContrato-collapseOne" class="accordion-collapse collapse" aria-labelledby="panelsSinContrato-headingOne" data-bs-parent="#accordionSinContrato">
            @* Agregado data-bs-parent y 'show' para que inicie abierto si lo deseas *@
            <div class="accordion-body">
                @if (Model.ListaParcelasSinContrato.Any())
                {
                    <div class="card shadow-sm">
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tipo</th>
                                        <th>Sección</th>
                                        <th>Parcela</th>
                                        <th>Difunto/s</th>
                                        <th>Estado introducción</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var opc in Model.ListaParcelasSinContrato)
                                    {
                                        string parcela = "";
                                        string estadoTramiteDisplay = EstadosEnum.ObtenerNombreEstado((TipotamiteEmun)(int)TipotamiteEmun.Introduccion, opc.EstadoTramiteIntroduccion);

                                        if (opc.TipoParcela == 1) //nicho
                                        {
                                            parcela = $"Nicho {opc.NroParcela.ToString()} Fila {opc.NroFila.ToString()}";
                                        }
                                        else if (opc.TipoParcela == 2)//fosa
                                        {
                                            parcela = $"Fosa {opc.NroParcela.ToString()}";
                                        }
                                        else if (opc.TipoParcela == 3) //panteon
                                        {
                                            parcela = $"Lote {opc.NroParcela.ToString()}";
                                        }

                                        string tipoParela = ((TipoParcelaEnum)opc.TipoParcela).ToString();
                                        <tr>
                                            <td>@tipoParela</td>
                                            <td>@opc.NombreSeccion.ToUpper()</td>
                                            <td>@parcela</td>
                                            <td>@opc.Difuntos.ToUpper()</td>
                                            <td>@estadoTramiteDisplay</td>
                                            @if (opc.EstadoTramiteIntroduccion == (int)EstadosIntroduccion.Finalizado)
                                            {
                                                <td>
                                                    <form asp-action="ContratoConcesion" asp-controller="ContratoConcesion" target="_blank" method="get" style="display: inline-block;">
                                                        <input type="hidden" name="parcelaId" value="@opc.ParcelaId" />
                                                        <button type="submit" class="btn btn-success" title="Generar nuevo contrato">
                                                            <i class="bi bi-plus-circle"></i> Concesión
                                                        </button>
                                                    </form>
                                                </td>
                                            }
                                            else
                                            {
                                                <td>No disponible</td>
                                            }
                                        </tr>

                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class= "alert alert-info" role = "alert" >
                        <i class="fas fa-info-circle"></i>
                        No hay parcelas sin contrato
                    </div>
                }
            </div>
        </div>
    </div>

</div>


