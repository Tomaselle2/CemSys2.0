@using CemSys2.ViewModel.ConcesionesViewModel
@using CemSys2.Enumerable
@model ContratoInicadoVM

@{
    ViewData["Title"] = "Contrato de concesión";
    string estadoTramiteDisplay = "";
    if (Model.EstadoTramiteId != null)
    {
        estadoTramiteDisplay = EstadosEnum.ObtenerNombreEstado((TipotamiteEmun)(int)TipotamiteEmun.ContratoDeConcesion, Model.EstadoTramiteId.Value);
    }

    decimal precioFinalMinimoParaQuitarFondo = 10000m;

    decimal porcentajeFondo = Model.PorcentajeFondo ?? 0;
    decimal montoMinimoDeFondo = Model.MontoMinimoFondo ?? 0;

    string fondoString = (porcentajeFondo * 100).ToString("N0");
}


@* Mostrar mensajes de éxito (desde TempData después de una redirección) *@
@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show alerta-contenedor" style="max-width: 800px;" role="alert">
        @TempData["MensajeExito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* Mostrar mensajes de error genéricos (si los pones en model.MensajeError) *@
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show alerta-contenedor" style="max-width: 800px;" role="alert">
        @Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["MensajeError"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show alerta-contenedor" style="max-width: 800px;" role="alert">
        @TempData["MensajeError"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger alert-dismissible fade show alerta-contenedor" role="alert" style="max-width: 800px;">
        @Html.ValidationSummary(false, "")
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@{//forma de pago
    string formaPago = "";

    if (Model.CantidadCuotaSeleccionada.HasValue)
    {
        if (Model.CantidadCuotaSeleccionada == 1)
        {
            formaPago = "1 solo pago";
        }
        else
        {
            decimal precio = (Model.PrecioFinal / Model.CantidadCuotaSeleccionada.Value);
            formaPago = $"{Model.CantidadCuotaSeleccionada.Value} cuotas mensuales y consecutivas de $ {precio.ToString("N2")}";
        }

    }
    else //otra forma de pago
    {
        formaPago = Model.OtraFormaPago;
    }

}

@{ //logica de parcela
    string parcela = "";
    if (Model.DatosParcela.TipoParcela == 1) //nicho
    {
        parcela = $"Nicho {Model.DatosParcela.NroParcela.ToString()} Fila {Model.DatosParcela.NroFila.ToString()}";
    }
    else if (Model.DatosParcela.TipoParcela == 2)//fosa
    {
        parcela = $"Fosa {Model.DatosParcela.NroParcela.ToString()}";
    }
    else if (Model.DatosParcela.TipoParcela == 3) //panteon
    {
        parcela = $"Lote {Model.DatosParcela.NroParcela.ToString()}";
    }

    string tipoParela = ((TipoParcelaEnum)Model.DatosParcela.TipoParcela).ToString();
}



@{//logica de cantidad de años
    //recibe la cantidad de añosId y devuelve el texto correspondiente
    string cantidadAniosTexto = "";
    switch (Model.CantidadAniosId)
    {
        case 1:
            cantidadAniosTexto = "1 AÑO";
            break;
        case 2:
            cantidadAniosTexto = "5 AÑOS";
            break;
        case 3:
            cantidadAniosTexto = "10 AÑOS";
            break;
        case 4:
            cantidadAniosTexto = "15 AÑOS";
            break;
        case 5:
            cantidadAniosTexto = "25 AÑOS";
            break;
        default:
            cantidadAniosTexto = $"{Model.CantidadAniosId} AÑOS";
            break;
    }
}
<div class="d-flex justify-content-center align-items-center">
    <div>
        <h1 class="tituloDePagina">Contrato de concesión</h1>
    </div>
</div>
<!-- Panel lateral derecho del historial -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasHistorial">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Historial</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div class="timeline">
            @foreach (var opc in Model.HistorialEstadoTramites)
            {
                int valor = opc.EstadoTramiteId;
                string estado = EstadosEnum.ObtenerNombreEstado((TipotamiteEmun)(int)TipotamiteEmun.ContratoDeConcesion, opc.EstadoTramiteId);
                <div class="timeline-item">
                    <div class="icon bg-success text-white">
                        <i class="bi bi-check-lg"></i>
                    </div>
                    <div class="content">
                        <p class="mb-0 fw-bold">@estado</p>
                        <small class="text-muted">
                            <i class="bi bi-clock"></i> @opc.Fecha.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!--Contenedor principal-->
<div class="contenedor-resumen" style="max-width: 1400px; padding-left: 20px; padding-right: 20px;">
    <div class="d-flex align-items-center justify-content-between">
        <h2 class="nroTramite">Trámite @Model.TramiteId</h2>
        <h3><b>Concesión:</b> <span class="nroTramite">@Model.NroConcesion</span></h3>
        <h3><strong>Estado: <span class="estadoTramite">@estadoTramiteDisplay</span></strong></h3>
    </div>
    <p class="separador"></p>
    <div class="contenedor-2-elementos">
        <!--datos de la parcela-->
        <div class="card-presentacion-datos">
            <div class="d-flex justify-content-center align-items-center">
                <!-- Título centrado -->
                <div class="flex-grow-1 text-center">
                    <p class="titulo-intermedio m-0">Datos de la parcela</p>
                </div>
                <div>
                    <form asp-action="HistorialParcela" asp-controller="Parcelas" method="get" target="_blank">
                        <input type="hidden" name="parcelaId" value="@Model.ParcelaId" />
                        <button class="btn-historial" type="submit" title="Ir a parcela">
                            <i class="bi bi-arrow-up-right"></i>
                        </button>
                    </form>
                </div>
            </div>
            <p class="separador"></p>
            <div>
                <p><b>Tipo de parcela: </b><span class="datoEncabezadoHistorialParcela dni-formateado">@tipoParela</span></p>
            </div>
            <div>
                <p><b>Sección: </b><span class="datoEncabezadoHistorialParcela">@Model.DatosParcela.NombreSeccion.ToUpper()</span></p>
            </div>
            <div>
                <p><b>Parcela: </b><span class="datoEncabezadoHistorialParcela">@parcela</span></p>
            </div>
        </div>

        <!--datos del contrato-->
        <div class="card-presentacion-datos">
            <div class="d-flex justify-content-center align-items-center">
                <!-- Título centrado -->
                <div class="flex-grow-1 text-center">
                    <p class="titulo-intermedio m-0">Datos de la concesión</p>
                </div>
                <!--Btn historial-->
                <div>
                    <button class="btn-historial" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasHistorial" title="Ver historial">
                        <i class="bi bi-clock-history"></i>
                    </button>
                </div>
            </div>
            <p class="separador"></p>
            <div>
                <p><b>Vencimiento: </b><span class="datoEncabezadoHistorialParcela">@Model.Vencimiento?.ToString("dd/MM/yyyy")</span></p>
            </div>
            <div>
                <p><b>Tiempo del contrato: </b><span class="datoEncabezadoHistorialParcela">@cantidadAniosTexto</span></p>
            </div>
            <div>
                <p><b>Precio final: </b><span class="datoEncabezadoHistorialParcela">$ @String.Format("{0:N2}", Model.PrecioFinal)</span></p>
            </div>
        </div>

        @foreach (var opc in Model.Titulares)
        {
            <!--datos del titular-->
            <div class="card-presentacion-datos">
                <div class="d-flex justify-content-center align-items-center">
                    <div class="flex-grow-1 text-center">
                        <p class="titulo-intermedio m-0">Titular</p>
                    </div>
                    <div>
                        <form asp-action="RedirigirAHistorial" asp-controller="Personas" method="get" target="_blank">
                            <input type="hidden" name="personaId" value="@opc.Id" />
                            <button type="submit" class="btn-historial" title="Ir a titular">
                                <i class="bi bi-arrow-up-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
               
                <p class="separador"></p>
                <div>
                    <p><b>Nombre: </b><span class="datoEncabezadoHistorialParcela">@opc.Apellido.ToUpper(), @opc.Nombre.ToUpper()</span></p>
                </div>
                <div>
                    <p><b>DNI: </b><span class="datoEncabezadoHistorialParcela dni-formateado">@opc.Dni</span></p>
                </div>
                
                <div>
                    <p><b>Celular: </b><span class="datoEncabezadoHistorialParcela">@opc.Celular</span></p>
                </div>
                <div>
                    <p><b>Correo: </b><span class="datoEncabezadoHistorialParcela">@opc.CorreoElectronico.ToLower()</span></p>
                </div>
                <div>
                    <p><b>Domicilio: </b><span class="datoEncabezadoHistorialParcela">@opc.Domicilio.ToUpper()</span></p>
                </div>
            </div>
        }

        <!--Forma de pago-->
        <div class="card-presentacion-datos">
            <div class="d-flex justify-content-center align-items-center">
                <!-- Título centrado -->
                <div class="flex-grow-1 text-center">
                    <p class="titulo-intermedio m-0">Forma de cobro</p>
                </div>
            </div>
            <p class="separador"></p>
            <div>
                <p><span class="datoEncabezadoHistorialParcela">@formaPago</span></p>
            </div>
        </div>
    </div>
</div>


<!-- Tabla de historial de difuntos actuales -->
<div class="accordion" id="accordionDifuntos">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingDifuntos">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-target="#panelsStayOpen-collapseDifuntos" aria-expanded="true" aria-controls="panelsStayOpen-collapseDifuntos">
                Difunto/s (@Model.DifuntosEnParcela.Count())
            </button>
        </h2>
        <div id="panelsStayOpen-collapseDifuntos" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingDifuntos">
            @if (Model.DifuntosEnParcela.Any())
            {
                <div class="contenedor-2-elementos">
                    @foreach (var opc in Model.DifuntosEnParcela)
                    {
                        string dni = (opc.DNI == "nn") ? "--------" : opc.DNI;
                        <div class="card-presentacion-datos">
                            <div class="d-flex justify-content-center align-items-center">
                                <div class="flex-grow-1 text-center">
                                    <p class="titulo-intermedio m-0">Difunto</p>
                                </div>
                                <div>
                                    <form asp-action="RedirigirAHistorial" asp-controller="Personas" method="get" target="_blank">
                                        <input type="hidden" name="personaId" value="@opc.DifuntoId" />
                                        <button type="submit" class="btn-historial" title="Ir a difunto">
                                            <i class="bi bi-arrow-up-right"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <p class="separador"></p>
                            
                            <div>
                                <p><b>Nombre: </b><span class="datoEncabezadoHistorialParcela">@opc.Apellido.ToUpper(), @opc.Nombre.ToUpper()</span></p>
                            </div>
                            <div>
                                <p><b>DNI: </b><span class="datoEncabezadoHistorialParcela dni-formateado">@dni</span></p>
                            </div>
                            <div>
                                <p><b>Ingreso: </b><span class="datoEncabezadoHistorialParcela">@opc.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</span></p>
                            </div>
                            <div>
                                <p><b>Estado: </b><span class="datoEncabezadoHistorialParcela">@opc.EstadoDifunto</span></p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <i class="fas fa-info-circle"></i>
                    No hay difuntos actuales en esta parcela.
                </div>
            }
        </div>
    </div>
</div>


<!-- Factura del contrato de concesion -->
<div class="accordion" id="accordionPanelsStayOpenExample">
    <div class="accordion-item acordeon-fijo-chico">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo acordeon-fijo-chico" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                Contrato de concesion
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            <div class="accordion-body" style="padding: 0">
                @* cuerpo del acordion *@
                @if (Model.ListaConceptosFactura.Any())
                {
                    <div class="card shadow-sm">
                        <div class="card-body p-0">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Concepto</th>
                                        <th>Precio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        //si el totalSinFondo es menor que
                                        decimal totalConceptos = Model.ListaConceptosFactura.Sum(r => r.PrecioUnitario);
                                        decimal totalConceptosSinFondo = 0;
                                        if (totalConceptos < precioFinalMinimoParaQuitarFondo) //hay que restar el montoMinimo del total
                                        {
                                            totalConceptosSinFondo = totalConceptos - montoMinimoDeFondo;
                                        }
                                        else //el precio es mayor que el monto minimo
                                        {
                                            totalConceptosSinFondo = totalConceptos / (1 + porcentajeFondo);
                                        }

                                        decimal fondoAyuda = ((totalConceptosSinFondo * porcentajeFondo) < montoMinimoDeFondo) ? montoMinimoDeFondo : totalConceptosSinFondo * porcentajeFondo;

                                        decimal subtotal = totalConceptosSinFondo + fondoAyuda;
                                    }
                                    @foreach (var opc in Model.ListaConceptosFactura)
                                    {
                                        <tr>
                                            <td>@opc.ConceptoTarifaria.Nombre.ToUpper()</td>
                                            <td>$ @String.Format("{0:N2}", totalConceptosSinFondo)</td>
                                        </tr>
                                    }
                                    <tr>
                                        <td>FONDO DE AYUDA CENTRO DE SALUD</td>
                                        <td>$ @String.Format("{0:N2}", fondoAyuda)</td>
                                    </tr>
                                    <tr class="subtotalFactura">
                                        <td><b>SUBTOTAL</b></td>
                                        <td><b>$ @String.Format("{0:N2}", subtotal)</b> </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                @* Fin cuerpo del acordeon *@
            </div>
        </div>
    </div>
</div>

<!--Fila de Total-->
<table class="table table-hover mb-0 filaTotalFactura">
    <tr class="totalFactura">
        <td><b>TOTAL</b></td>
        <td><b>$ @String.Format("{0:N2}", Model.FacturaInterna.Total) </b></td>
    </tr>
</table>


<!--Tabla facturas emitidas -->
<div class="accordion" id="accordionPanelsStayOpenExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                Facturas
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            <div class="accordion-body" style="padding: 0">
                @* cuerpo del acordion *@
                <table class="table table-hover mb-0">
                    <tr style="font-size: 1.2rem">
                        <td><b>Pendiente: $ @String.Format("{0:N2}", Model.Pendiente)</b></td>
                    </tr>
                </table>
                @if (Model.ListaFacturas.Count > 0)
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Nro Factura</th>
                                <th>Fecha</th>
                                <th>Descripción</th>
                                <th>Importe</th>
                                <th>Contribuyente</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var opc in Model.ListaFacturas)
                            {
                                <tr>
                                    <td>@opc.Id</td>
                                    <td>@opc.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@opc.Descripcion</td>
                                    <td>$@String.Format("{0:N2}", opc.Total)</td>
                                    <td>@opc.NombreContribuyente?.ToUpper()</td>
                                    <td>@(((EstadosFactura)opc.EstadoId.Value).GetDisplayName())</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <!-- Botón para abrir modal de anular factura-->
                                            @if (Model.EstadoTramiteId != (int)EstadosContratoConcesion.Activa
                                                                                && opc.EstadoId != (int)EstadosFactura.Cobrado
                                                                                && opc.EstadoId != (int)EstadosFactura.Anulado)
                                            {
                                                <button class="btn btn-danger anularFactura" type="button" data-facturaid="@opc.Id" title="Anular">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            }

                                            <button class="btn-historial" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasHistorialFactura"
                                                    data-facturaid="@opc.Id" title="Historial">
                                                <i class="bi bi-clock-history"></i>
                                            </button>
                                            <form asp-action="GenerarFactura" asp-controller="Cajero" method="get">
                                                <input type="hidden" name="facturaId" value="@opc.Id" />
                                                <button type="submit" class="btn btn-warning d-flex align-items-center gap-1">
                                                    <i class="bi bi-download"></i>
                                                </button>
                                            </form>
                                        </div>

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-info-circle"></i>
                        No hay facturas registradas.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Panel lateral derecho del historial de la factura -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasHistorialFactura">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Historial</h5>
        <h5 class="offcanvas-title" id="tituloFactura">Factura:</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body" id="historialContenido">
        <div class="text-center text-muted">
            <i class="bi bi-hourglass-split"></i> Selecciona una factura para ver su historial.
        </div>
    </div>
</div>

<!-- formulario nueva factura -->
@if (Model.Pendiente > 0)
{
    <div class="accordion" id="accordionPanelsStayOpenExample">
        <div class="accordion-item">
            <h2 class="accordion-header" id="panelsStayOpen-headingOne">
                <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                    Nueva factura
                </button>
            </h2>
            <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
                <div class="accordion-body">
                    @* cuerpo del acordion *@
                    <form asp-action="EmitirFactura" method="post" id="formRecibo" class="form-box" enctype="multipart/form-data" onsubmit="handleFormSubmit()">
                        <div class="mb-3">
                            <!--decreto-->
                            <input type="checkbox" asp-for="Decreto" id="decreto" onchange="handleDecretoChange(this)" />
                            <label for="decreto">Decreto municipal</label>
                        </div>

                        <div class="mb-3 form-columns-container3">
                            <div>
                                <!--Contribuyente-->
                                <label for="">Contribuyente<span class="obligatorio"> * </span></label>
                                <div class="form-columns-container3">
                                    <div>
                                        <input id="contribuyenteDisplay" value="@(Model.Nombre + " " + Model.Apellido)" class="form-control" type="text" placeholder="Seleccione un contribuyente" disabled />
                                    </div>
                                    <div>
                                        <div>
                                            <button class="btn btn-success" id="agregarContribuyenteButton" type="button">
                                                <i class="bi bi-person-plus" id="contribuyenteIcon"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <!--Descripcion general de la factura-->
                                <label for="conceptoRecibo">Descripción<span class="obligatorio"> * </span></label>
                                <input asp-for="Descripcion" id="conceptoRecibo" class="form-control" type="text" maxlength="100" required />
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-columns-container3">
                            <div class="elemento-ocultar-check">
                                <!--lista de conceptos de la tarifaria para introducción-->
                                <label>Concepto</label>
                                <select id="conceptoSelect" class="form-select">
                                    <option value="">--Elija una opción--</option>
                                    @foreach (var item in Model.ListaConceptosTarifaria)
                                    {
                                        <option value="@item.PrecioId"
                                                data-precio="@item.Precio"
                                                data-tarifariaid="@item.TarifariaId"
                                                data-conceptoid="@item.ConceptoTarifariaId"
                                                data-tipoconcepto="@item.TipoConceptoTarifariaId">
                                            @item.NombreConcepto
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="elemento-ocultar-check">
                                <label>Precio</label>
                                <input type="text" id="precioInput" class="form-control" readonly />
                            </div>

                            <div style="display: none" id="montoDecreto">
                                <label for="montoDecreto">Importe<span class="obligatorio"> * </span></label>
                                <input asp-for="MontoDecreto" class="form-control" type="number" min="1" @*max="@Model.ResumenIntroduccion[0].Pendiente"*@ required placeholder="0.00" step="0.01" />
                                <span asp-validation-for="MontoDecreto" class="text-danger"></span>
                            </div>
                        </div>
