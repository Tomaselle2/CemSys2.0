                                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                <span class="loading-text d-none">Cargando...</span>
                            </button>
                        </div>
                        <input type="hidden" asp-for="TramiteId" value="@Model.TramiteId" />
                        <input type="hidden" asp-for="IdContribuyente" id="idContribuyenteHidden" />
                        <input type="hidden" asp-for="Dni" id="dniHidden" />
                        <input type="hidden" asp-for="Sexo" id="sexoHidden" />
                        <input type="hidden" asp-for="Nombre" id="nombreHidden" />
                        <input type="hidden" asp-for="Apellido" id="apellidoHidden" />
                        <input type="hidden" asp-for="Pendiente" />
                        <input type="hidden" asp-for="ParcelaId" value="@Model.DatosParcela.ParcelaId" />
                        <input type="hidden" asp-for="NroConcesion" value="@Model.NroConcesion" />
                        <input type="hidden" asp-for="EstadoTramiteId" value="@Model.EstadoTramiteId" />
                        <div id="detalleHiddenInputs"></div>

                    </form>
                    @* Fin cuerpo del acordeon *@
                </div>
            </div>
        </div>
    </div>

}


<!--Tabla Archivos del contrato de concesion -->
<div class="accordion" id="accordionPanelsStayOpenExample">
    <div class="accordion-item">
        <h2 class="accordion-header" id="panelsStayOpen-headingOne">
            <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                Archivos
            </button>
        </h2>
        <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
            <div class="accordion-body" style="padding: 0">
                @* cuerpo del acordion *@
                @if (Model.ListaArchivos.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Descripción</th>
                                <th>Fecha de carga</th>
                                <th>Categoría</th>
                                <th>Archivo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var opc in Model.ListaArchivos)
                            {
                                <tr>
                                    <td>@opc.Descripcion</td>
                                    <td>@opc.FechaCreacion?.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@opc.CategoriaArchivo</td>
                                    <td>
                                        <!-- Botón para abrir modal de editar archivo-->
                                        @if (Model.EstadoTramiteId == (int)EstadosContratoConcesion.PendienteDeDocumentacion)
                                        {
                                            <button class="btn btn-primary btnEditarArchivoCons"
                                                    type="button"
                                                    data-id="@opc.ArchivoId"
                                                    data-concepto="@opc.Descripcion"
                                                    data-archivo="@opc.NombreArchivo",
                                                    data-categoria="@opc.CategoriaArchivo">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        }

                                        <!-- Botón para abrir modal de ver archivo-->
                                        <button type="button"
                                                class="btn-modificar btn-sm"
                                                title="Ver"
                                                onclick="verRecibo('@opc.ArchivoId')">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @* Fin cuerpo del acordeon *@
            </div>
        </div>
        @if (Model.EstadoTramiteId == (int)EstadosContratoConcesion.PendienteDeDocumentacion)
        {
            <button class="btn btn-success m-3"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#SubirArchivoContrato">
                @*  data-archivo="@opc.Archivo?.NombreArchivo" *@
                <i class="bi bi-file-earmark-arrow-up" style="font-size: 20px;"></i>
                Subir archivo
            </button>
        }
    </div>
</div>


