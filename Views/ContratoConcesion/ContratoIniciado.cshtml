            </div>
            <div class="modal-body">
                ¿Está seguro que desea finalizar el paso <b>Pendiente de documentación</b>?
                <br/>
                No podrá editar archivos.
                <br />
                No podrá subir nuevos archivos.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" id="btnConfirmar">Finalizar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let listaDetalles = @Html.Raw(Model.ListaDetalleFactura != null ? Json.Serialize(Model.ListaDetalleFactura) : "[]");
        const listaConceptosTarifaria = @Html.Raw(Model.ListaConceptosTarifaria != null ? Json.Serialize(Model.ListaConceptosTarifaria) : "[]");

        // Convertir a número de forma segura
        let porcentajeFondoStr = '@(Model.PorcentajeFondo?.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) ?? "0.05")';
        const porcentajeFondo = parseFloat(porcentajeFondoStr) || 0.05; 

    </script>


    <script src="~/js/_Facturacion.js"></script>

    <script>// Formatear DNI
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.dni-formateado').forEach(elemento => {
                const dni = elemento.textContent;
                if (dni !== '--------') {
                    elemento.textContent = dni.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                }
            });
        });
    </script>

    <script>// Lógica para editar un recibo o archivo
        document.addEventListener("DOMContentLoaded", function () {
            //para abrir el modal agregar archivo
              document.querySelectorAll('.btnAgregarArchivo').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.dataset.id;
                    const concepto = this.dataset.concepto;
                    const archivo = this.dataset.archivo;

                    document.getElementById('idArchivoHidden').value = id;
                    document.getElementById('descripcionArchivo').value = concepto;
                    document.getElementById('descripcionArchivo').value = "";


                    $('#SubirArchivoContrato').modal('show');
                });
            });

            // Lógica para editar un archivo (modal EditarArchivoModal)
            // Para editar archivo
            document.querySelectorAll('.btnEditarArchivoCons').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.dataset.id;
                    const concepto = this.dataset.concepto;
                    const archivo = this.dataset.archivo;
                    const categoria = this.dataset.categoria;

                    // Llenar el formulario de edición de archivo
                    document.getElementById('idArchivoHidden').value = id;
                    document.getElementById('descripcionArchivoEdicion').value = concepto;
                    document.getElementById('archivoActualArchivo').value = archivo || "Sin archivo";

                    // Establecer la categoría seleccionada
                    const selectCategoria = document.getElementById('categoriaArchivoEdicion');
                    if (selectCategoria) {
                        selectCategoria.value = categoria;
                    }

                    // Mostrar el modal correcto
                    const modal = new bootstrap.Modal(document.getElementById('EditarArchivoModal'));
                    modal.show();
                });
            });

        });
    </script>

    <script>//Modal de Confirmar finalizar pago pendiente documentacion
        document.addEventListener("DOMContentLoaded", function () {
            const btnConfirmar = document.getElementById("btnConfirmar");
            const form = document.getElementById("formFinalizarPendDoc");

            btnConfirmar.addEventListener("click", function () {
                form.submit();
            });
        });
    </script>

   


}