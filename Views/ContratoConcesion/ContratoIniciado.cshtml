                        <div style="display: none" id="archivoDecreto">
                            <label for="archivoDecreto">Archivo<span class="obligatorio"> * (.png .jpg .pdf)</span></label>
                            <input asp-for="ArchivoDecreto" class="form-control" type="file" accept=".png,.jpg,.jpeg,.pdf" required />
