                        <input asp-for="Concepto" id="descripcionArchivo" class="form-control" type="text" maxlength="100" required />
                        <span asp-validation-for="Concepto" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Categoria" class="control-label"></label>
                        <select asp-for="Categoria"
                                asp-items="Model.Categorias"
                                class="form-control"
                        required>
                            <option value="">-- Seleccione una categoría --</option>
                        </select>
                        <span asp-validation-for="Categoria" class="text-danger"></span>
                    </div>
                    <div>
                        <label for="archivoRecibo">Seleccione el archivo<span class="obligatorio"> (.png .jpg .pdf)</span></label>
                        <input asp-for="ArchivoRecibo" id="archivoContrato" class="form-control" type="file" accept=".png,.jpg,.jpeg,.pdf" required/>
                        <span asp-validation-for="ArchivoRecibo" class="text-danger"></span>
                    </div>
                    <input type="hidden" asp-for="TramiteId" value="@Model.TramiteId" />
                    <input type="hidden" asp-for="NroConcesion" value="@Model.NroConcesion" />
                    <input type="hidden" asp-for="ParcelaId" value="@Model.ParcelaId" />
                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancelar</button>
                        <div class="my-3">
                            <button type="submit" id="btnCargarArchivo" class="my-3 btn btn-success">
                                <span class="btn-text">Editar</span>
                                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                <span class="loading-text d-none">Cargando...</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
