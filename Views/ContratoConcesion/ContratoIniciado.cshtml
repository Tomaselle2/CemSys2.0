<!-- formulario nuevo recibo -->
@if (Model.Factura.Pendiente > 0)
{
    <div class="accordion" id="accordionPanelsStayOpenExample">
        <div class="accordion-item">
            <h2 class="accordion-header" id="panelsStayOpen-headingOne">
                <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-toggle="" data-bs-target="#panelsStayOpen-collapseOne" aria-expanded="false" aria-controls="panelsStayOpen-collapseOne">
                    Nuevo recibo
                </button>
            </h2>
            <div id="panelsStayOpen-collapseOne" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingOne">
                <div class="accordion-body">
                    @* cuerpo del acordion *@
                    <form asp-action="CargarRecibo" method="post" id="formRecibo" class="form-box" enctype="multipart/form-data" onsubmit="handleFormSubmit()">
                        <div class="mb-3">
                            <!--decreto-->
                            <input type="checkbox" asp-for="Decreto" id="decreto" onchange="handleDecretoChange(this)" />
                            <label for="decreto">Decreto municipal</label>
                        </div>

                        <div class="mb-3">
                            <!--Contribuyente-->
                            <label for="">Contribuyente<span class="obligatorio"> * </span></label>
                            <div class="form-columns-container3">
                                <div>
                                    <input id="contribuyenteDisplay" asp-for="IdContribuyente" class="form-control" type="text" placeholder="Seleccione un contribuyente" disabled />
                                </div>
                                <div>
                                    <div>
                                        <button class="btn btn-success" id="agregarContribuyenteButton" type="button">
                                            <i class="bi bi-person-plus" id="contribuyenteIcon"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-columns-container3">
                            <div>
                                <label for="conceptoRecibo">Concepto<span class="obligatorio"> * </span></label>
                                <input asp-for="Concepto" id="conceptoRecibo" class="form-control" type="text" maxlength="100" required />
                                <span asp-validation-for="Concepto" class="text-danger"></span>
                            </div>

                            <div>
                                <label for="montoRecibo">Monto<span class="obligatorio"> * </span></label>
                                <input asp-for="Monto" id="montoRecibo" class="form-control" type="number" min="1" max="@Model.Factura.Pendiente" required placeholder="0.00" step="0.01" />
                                <span asp-validation-for="Monto" class="text-danger"></span>
                            </div>
                        </div>

                        <div>
                            <label for="archivoRecibo">Archivo<span class="obligatorio"> * (.png .jpg .pdf)</span></label>
                            <input asp-for="ArchivoRecibo" id="archivoRecibo" class="form-control" type="file" accept=".png,.jpg,.jpeg,.pdf" required />
                            <span asp-validation-for="ArchivoRecibo" class="text-danger"></span>
                        </div>
                        <div class="my-3">
                            <button type="submit" id="btnCargarRecibo" class="my-3 btn btn-success">
                                <span class="btn-text">Cargar recibo</span>
                                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                <span class="loading-text d-none">Cargando...</span>
                            </button>
                        </div>
                        <input type="hidden" asp-for="TramiteId" value="@Model.TramiteId" />
                        <input type="hidden" asp-for="IdFactura" value="@Model.Factura.Id" />
                        <input type="hidden" asp-for="NroConcesion" value="@Model.NroConcesion" />
                        <input type="hidden" asp-for="ParcelaId" value="@Model.ParcelaId" />
                        <input type="hidden" asp-for="IdContribuyente" id="idContribuyenteHidden" />
                        <input type="hidden" asp-for="Dni" id="dniHidden" />
                        <input type="hidden" asp-for="Sexo" id="sexoHidden" />
                        <input type="hidden" asp-for="Nombre" id="nombreHidden" />
                        <input type="hidden" asp-for="Apellido" id="apellidoHidden" />
                    </form>
                    @* Fin cuerpo del acordeon *@
                </div>
            </div>
        </div>
    </div>
}


<!--Modal contribuyente-->
<div class="modal fade" id="ContribuyenteModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Contribuyente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formContribuyente" class="needs-validation" novalidate>
                    <div class="d-flex justify-content-between align-items-center p-2">
                        <div>
                            <!--DNI-->
                            <label for="dni">DNI<span class="obligatorio"> * </span></label>
                            <input class="form-control" id="dniInput" type="text" pattern="[0-9]+" maxlength="8" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                            <div class="invalid-feedback">El DNI es obligatorio</div>
                        </div>
                        <div>
                            <!--Sexo-->
                            <label for="sexoInput">Sexo<span class="obligatorio"> * </span></label>
                            <select class="form-select" id="sexoInput" required>
                                <option value="">--Elija una opción--</option>
                                <option value="masculino">Masculino</option>
                                <option value="femenino">Femenino</option>
                                <option value="otro">Otro</option>
                            </select>
                            <div class="invalid-feedback">El sexo es obligatorio</div>
                        </div>
                    </div>

                    <!-- Campos adicionales (inicialmente ocultos) -->
                    <div id="camposAdicionales" style="display: none;">
                        <div class="mt-3">
                            <!--Nombre-->
                            <label for="nombreInput">Nombre<span class="obligatorio"> * </span></label>
                            <input class="form-control" id="nombreInput" type="text" maxlength="60" minlength="2" />
                            <div class="invalid-feedback">El nombre es obligatorio</div>
                        </div>

                        <div class="mt-3">
                            <!--Apellido-->
                            <label for="apellidoInput">Apellido<span class="obligatorio"> * </span></label>
                            <input class="form-control" type="text" id="apellidoInput" maxlength="60" minlength="2" />
                            <div class="invalid-feedback">El apellido es obligatorio</div>
                        </div>
                    </div>

                    <!-- Mensaje de error -->
                    <div id="errorMessage" class="alert alert-danger mt-3" style="display: none;"></div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success" id="btnAccionContribuyente">Buscar</button>
                    </div>

                    <input type="hidden" asp-for="NroConcesion" value="@Model.NroConcesion" />
                    <input type="hidden" asp-for="ParcelaId" value="@Model.ParcelaId" />
                </form>
            </div>
        </div>
    </div>
</div>


<!--Modal Editar Recibo-->
<div class="modal fade" id="EditarReciboModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Editar archivo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form asp-action="EditarRecibo" method="post" id="formEditarRecibo" class="form-box" enctype="multipart/form-data">
                    <div>
                        <label for="conceptoRecibo">Descripción<span class="obligatorio"> * </span></label>
                        <input asp-for="Concepto" id="conceptoReciboEdicion" class="form-control" type="text" maxlength="100" required />
                        <span asp-validation-for="Concepto" class="text-danger"></span>
                    </div>
                    <div>
                        <label>Archivo actual</label>
                        <input type="text" id="archivoActualRecibo" class="form-control" readonly />
                    </div>
                    <div>
                        <label for="archivoRecibo">Nuevo archivo (opcional) <span class="obligatorio"> (.png .jpg .pdf)</span></label>
                        <input asp-for="ArchivoRecibo" id="archivoRecibo" class="form-control" type="file" accept=".png,.jpg,.jpeg,.pdf" />
                        <span asp-validation-for="ArchivoRecibo" class="text-danger"></span>
                    </div>
                    <input type="hidden" asp-for="IdRecibo" id="idReciboHidden" />
                    <input type="hidden" asp-for="TramiteId" value="@Model.TramiteId" />
                    <input type="hidden" asp-for="IdFactura" value="@Model.Factura.Id" />
                    <input type="hidden" asp-for="IdContribuyente" id="idContribuyenteHidden" />
                    <input type="hidden" asp-for="NroConcesion" value="@Model.NroConcesion" />
                    <input type="hidden" asp-for="ParcelaId" value="@Model.ParcelaId" />
                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancelar</button>
                        <div class="my-3">
                            <button type="submit" id="btnCargarRecibo" class="my-3 btn btn-success">
                                <span class="btn-text">Editar</span>
                                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                                <span class="loading-text d-none">Cargando...</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<!--Modal del visor de archivo -->
<div class="modal fade" id="modalVerRecibo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <!-- Extra grande -->
        <div class="modal-content">
