@using CemSys2.ViewModel.ConcesionesViewModel
@using CemSys2.Enumerable
@model GenerarContratoVM

@{
    ViewData["Title"] = "Contrato de concesión";
}

<h1 class="tituloDePagina">Contrato de concesión</h1>

<!--Mostrar mensajes de error genéricos -->
@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger alert-dismissible fade show alerta-contenedor" role="alert">
        @Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<form asp-action="GeneraContrato" method="post" id="formPrincipal">
    <!-- Tabla de historial de difuntos actuales -->
    <div class="accordion" id="accordionDifuntos">
        <div class="accordion-item">
            <h2 class="accordion-header" id="panelsStayOpen-headingDifuntos">
                <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-target="#panelsStayOpen-collapseDifuntos" aria-expanded="true" aria-controls="panelsStayOpen-collapseDifuntos">
                    Difunto/s (@Model.DifuntosEnParcela.Count())
                </button>
            </h2>
            <div id="panelsStayOpen-collapseDifuntos" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingDifuntos">
                @if (Model.DifuntosEnParcela.Any())
                {
                    <div class="contenedor-2-elementos">
                        @foreach (var opc in Model.DifuntosEnParcela)
                        {
                            string dni = (opc.DNI == "nn") ? "--------" : opc.DNI;
                            <div class="card-presentacion-datos">
                                <div>
                                    <p><b>DNI: </b><span class="datoEncabezadoHistorialParcela dni-formateado">@dni</span></p>
                                </div>
                                <div>
                                    <p><b>Nombre: </b><span class="datoEncabezadoHistorialParcela">@opc.Apellido.ToUpper(), @opc.Nombre.ToUpper()</span></p>
                                </div>
                                <div>
                                    <p><b>Ingreso: </b><span class="datoEncabezadoHistorialParcela">@opc.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</span></p>
                                </div>
                                <div>
                                    <p><b>Estado: </b><span class="datoEncabezadoHistorialParcela">@opc.EstadoDifunto</span></p>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-info-circle"></i>
                        No hay difuntos actuales en esta parcela.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sección de titulares -->
    <div class="accordion" id="accordionTitulares">
        <div class="accordion-item">
            <h2 class="accordion-header" id="panelsStayOpen-headingTitulares">
                <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-target="#panelsStayOpen-collapseTitulares" aria-expanded="true" aria-controls="panelsStayOpen-collapseTitulares">
                    Titulares (<span id="contadorTitulares">0</span>)
                </button>
            </h2>
            <div id="panelsStayOpen-collapseTitulares" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingTitulares">
                <div class="mb-3 p-3">
                    <!-- Contenedor para titulares (aquí se renderizarán los inputs) -->
                    <div id="contenedorTitulares"></div>

                    <!-- Botón para agregar titular -->
                    <div class="text-center mt-3">
                        <button class="btn btn-success" id="agregarContribuyenteButton" type="button">
                            <i class="bi bi-person-plus" id="contribuyenteIcon"></i> Agregar Titular
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección de concesion -->
    <div class="accordion" id="accordionConcesion">
        <div class="accordion-item">
            <h2 class="accordion-header" id="panelsStayOpen-headingConcesion">
                <button class="accordion-button nueva-seccion acordeon-fijo" type="button" data-bs-target="#panelsStayOpen-collapseConcesion" aria-expanded="true" aria-controls="panelsStayOpen-collapseConcesion">
                    Concesión
                </button>
            </h2>
            <div id="panelsStayOpen-collapseConcesion" class="accordion-collapse collapse show" aria-labelledby="panelsStayOpen-headingConcesion">
                <!--Cuerpo-->
                @{
                    string parcela = "";
                    if (Model.DatosParcela.TipoParcela == 1) //nicho
                    {
                        parcela = $"Nicho {Model.DatosParcela.NroParcela.ToString()} Fila {Model.DatosParcela.NroFila.ToString()}";
                    }
                    else if (Model.DatosParcela.TipoParcela == 2)//fosa
                    {
                        parcela = $"Fosa {Model.DatosParcela.NroParcela.ToString()}";
                    }
                    else if (Model.DatosParcela.TipoParcela == 3) //panteon
                    {
                        parcela = $"Lote {Model.DatosParcela.NroParcela.ToString()}";
                    }

                    string tipoParela = ((TipoParcelaEnum)Model.DatosParcela.TipoParcela).ToString();
                }

                <!--datos de la parcela-->
                <div class="contenedor-2-elementos">
                    <div class="card-presentacion-datos">
                        <div>
                            <p class="titulo-intermedio">Datos de la parcela</p>
                        </div>
                        <p class="separador"></p>
                        <div>
                            <p><b>Tipo de parcela: </b><span class="datoEncabezadoHistorialParcela dni-formateado">@tipoParela</span></p>
                        </div>
                        <div>
                            <p><b>Sección: </b><span class="datoEncabezadoHistorialParcela">@Model.DatosParcela.NombreSeccion.ToUpper()</span></p>
                        </div>
                        <div>
                            <p><b>Parcela: </b><span class="datoEncabezadoHistorialParcela">@parcela</span></p>
                        </div>
                    </div>
                </div>

                <div class="p-3">
                    <label>Precio de la concesión<span class="obligatorio"> * </span></label>
                    <select asp-for="PrecioSeleccionado" class="form-control" id="selectCantidadPrecio">
                        <option value="">-- Seleccione la cantidad de años --</option>
                        @foreach (var precio in Model.PreciosFiltrados)
                        {
                            <option value="@precio.precioId"
                                    selected="@(Model.PrecioSeleccionado == precio.precioId ? "selected" : null)">
                                @precio.aniosConcesion años - $ @precio.Precio.ToString("N2")
                            </option>
                        }
                    </select>
                    <span asp-validation-for="PrecioSeleccionado" class="text-danger"></span>
                </div>

                <div class="form-columns-container3 mb-3 p-3">
                    <div>
                        <label>Vencimiento<span class="obligatorio"> * </span></label>
                        <input class="form-control" type="date" required id="vencimientoConcesion" asp-for="Vencimiento" />
                        <span asp-validation-for="Vencimiento" class="text-danger"></span>
                    </div>
                    <div>
                        <label>N° Concesión<span class="obligatorio"> * </span></label>
                        <input class="form-control" type="number" max="99999" required id="nroConcesion" asp-for="NroConcesion" />
                        <span asp-validation-for="NroConcesion" class="text-danger"></span>
                    </div>
                </div>

                <div class="p-3">
                    <label>Forma de pago<span class="obligatorio"> * </span></label>
                    <div class ="form-columns-container3 mb-3">
                        <div>
                            <select class="form-control" asp-for="FormaDePago">
                                <option value="">--Seleccione una forma de pago--</option>
                                <option value="cuota">Cuotas</option>
                                <option value="otra">Otra</option>
                            </select>
                        </div>
                        <div>
                            <select class="form-control" asp-for="CantidadCuotaSeleccionada" asp-items="@(new SelectList(Model.CantidadCuotas, "Id", "Texto"))">
                                <option value="">--Elija una cuota--</option>
                            </select>
                        </div>
                        <div>
                            <input class="form-control" type="text" id="valorCuota" readonly />
                        </div>
                    </div>
                    
                    <div>
                        <label>Escriba la forma de pago</label>
                        <input class="form-control" type="text" id="otraForma" readonly />
                    </div>
                </div>

                <input type="hidden" asp-for="ParcelaId" value="@Model.ParcelaId" />
                <input type="hidden" asp-for="CantidadAnios" id="cantidadAnios" />

                <input type="submit" value="Generar contrato" class="btn btn-success" />
            </div>
        </div>
    </div>
</form>

<!-- Modal contribuyente-->
<div class="modal fade" id="TitularModal" tabindex="-1" aria-labelledby="titularModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titularModalLabel">Buscar/Registrar Titular</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formContribuyente" class="needs-validation" novalidate>
                    <div class="row">
                        <div class="col-md-6">
                            <label for="dniInput">DNI<span class="obligatorio"> * </span></label>
                            <input class="form-control" id="dniInput" type="text" pattern="[0-9]+" maxlength="8" oninput="this.value = this.value.replace(/[^0-9]/g, '')" required />
                            <div class="invalid-feedback">El DNI es obligatorio</div>
                        </div>
                        <div class="col-md-6">
                            <label for="sexoInput">Sexo<span class="obligatorio"> * </span></label>
                            <select class="form-select" id="sexoInput" required>
                                <option value="">--Elija una opción--</option>
                                <option value="masculino">Masculino</option>
                                <option value="femenino">Femenino</option>
                                <option value="otro">Otro</option>
                            </select>
                            <div class="invalid-feedback">El sexo es obligatorio</div>
                        </div>
                    </div>

                    <!-- Campos adicionales (inicialmente ocultos) -->
                    <div id="camposAdicionales" style="display: none;">
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <label for="nombreInput">Nombre<span class="obligatorio"> * </span></label>
                                <input class="form-control" id="nombreInput" type="text" maxlength="60" minlength="2" />
                                <div class="invalid-feedback">El nombre es obligatorio</div>
                            </div>
                            <div class="col-md-6">
                                <label for="apellidoInput">Apellido<span class="obligatorio"> * </span></label>
                                <input class="form-control" type="text" id="apellidoInput" maxlength="60" minlength="2" />
                                <div class="invalid-feedback">El apellido es obligatorio</div>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <label for="celularInput">Celular</label>
                                <input class="form-control" type="text" id="celularInput" maxlength="25" pattern="[0-9]+" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                                <div class="invalid-feedback">No puede tener más de 25 dígitos</div>
                            </div>
                            <div class="col-md-6">
                                <label for="correoInput">Correo electrónico</label>
                                <input class="form-control" type="email" maxlength="100" id="correoInput" />
                                <div class="invalid-feedback">Debe contener "@@" y "." </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <label for="domicilioInput">Domicilio<span class="obligatorio"> * </span></label>
                            <input class="form-control" type="text" maxlength="100" minlength="2" id="domicilioInput" />
                            <div class="invalid-feedback">El domicilio es obligatorio</div>
                        </div>
                    </div>

                    <!-- Mensaje de error -->
                    <div id="errorMessage" class="alert alert-danger mt-3" style="display: none;"></div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" form="formContribuyente" class="btn btn-primary" id="btnAccionContribuyente">Buscar</button>
            </div>
        </div>
    </div>
</div>

<!-- CSS adicional para múltiples titulares -->
<style>
    .titular-item {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        margin-bottom: 15px;
    }

    .titular-header {
        background-color: #e9ecef;
        padding: 10px 15px;
        border-radius: 8px 8px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .titular-number {
        font-weight: bold;
        color: #495057;
    }

    .btn-eliminar {
        padding: 5px 10px;
        font-size: 0.8rem;
    }
</style>


<!-- Modal Confirmación Eliminar -->
<div class="modal fade" id="confirmarEliminarModal" tabindex="-1" aria-labelledby="confirmarEliminarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="confirmarEliminarModalLabel">Confirmar eliminación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ¿Está seguro de que desea eliminar este titular?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarEliminar" class="btn btn-danger">Eliminar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script> // Formatear DNI
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.dni-formateado').forEach(elemento => {
                const dni = elemento.textContent;
                if (dni !== '--------') {
                    elemento.textContent = dni.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
                }
            });
        });
    </script>

    <script>//logica de titulares
        // Variables globales
        let titulares = [];
        let estadoModal = 'buscar';
        let titularAEliminar = null;
        const normalizarDni = (v) => String(v ?? '').trim().replace(/\D/g, '');

        // Elementos del DOM
        const formPrincipal = document.getElementById('formPrincipal');
        const agregarTitularButton = document.getElementById('agregarContribuyenteButton');
        const formTitular = document.getElementById('formContribuyente');
        const contenedorTitulares = document.getElementById('contenedorTitulares');
        const contadorTitularesSpan = document.getElementById('contadorTitulares');
        const dniInput = document.getElementById('dniInput');
        const sexoInput = document.getElementById('sexoInput');
        const nombreInput = document.getElementById('nombreInput');
        const apellidoInput = document.getElementById('apellidoInput');
        const celularInput = document.getElementById('celularInput');
        const correoInput = document.getElementById('correoInput');
        const domicilioInput = document.getElementById('domicilioInput');
        const camposAdicionales = document.getElementById('camposAdicionales');
        const btnAccionTitular = document.getElementById('btnAccionContribuyente');
        const errorMessage = document.getElementById('errorMessage');

        // Event Listeners
        agregarTitularButton.addEventListener('click', function() {
            resetearModal();
            $('#TitularModal').modal('show');
        });

        formTitular.addEventListener('submit', function(event) {
            event.preventDefault();
            if (!validarFormulario()) return;

            if (estadoModal === 'buscar') {
                buscarTitular();
            } else if (estadoModal === 'registrar') {
                registrarTitular();
            }
        });

        // Validar formulario principal antes de enviar
        formPrincipal.addEventListener('submit', function(event) {
            if (titulares.length === 0) {
                event.preventDefault();
                alert('Debe agregar al menos un titular');
                return false;
            }
            return true;
        });

        // Funciones principales
        function validarFormulario() {
            let esValido = true;
            formTitular.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));

            // Validar DNI
            if (!dniInput.value.trim() || dniInput.value.length < 1) {
                dniInput.classList.add('is-invalid');
                esValido = false;
            }

            // Validar sexo
            if (!sexoInput.value) {
                sexoInput.classList.add('is-invalid');
                esValido = false;
            }

            // Verificar si el DNI ya existe
            const dniNorm = normalizarDni(dniInput.value);
            if (titulares.some(t => normalizarDni(t.dni ?? t.Dni) === dniNorm)) {
                dniInput.classList.add('is-invalid');
                mostrarError('Ya existe un titular con este DNI');
                return false;
            }

            // Si estamos en modo registrar, validar campos adicionales
            if (estadoModal === 'registrar') {
                if (!nombreInput.value.trim() || nombreInput.value.length < 2) {
                    nombreInput.classList.add('is-invalid');
                    esValido = false;
                }
                if (!apellidoInput.value.trim() || apellidoInput.value.length < 2) {
                    apellidoInput.classList.add('is-invalid');
                    esValido = false;
                }
                if (!domicilioInput.value.trim() || domicilioInput.value.length < 2) {
                    domicilioInput.classList.add('is-invalid');
                    esValido = false;
                }

                // Validar correo si tiene algo escrito
                if (correoInput.value.trim() && !new RegExp("^[^\\s@@]+@@[^\\s@@]+\\.[^\\s@@]+$").test(correoInput.value.trim())) {
                    correoInput.classList.add('is-invalid');
                    esValido = false;
                }
            }

            return esValido;
        }

        function buscarTitular() {
            mostrarCargando(true);
            ocultarError();

            const datos = {
                Dni: parseInt(dniInput.value),
                Sexo: sexoInput.value,
            };

            fetch('/ContratoConcesion/BuscarContribuyente', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify(datos)
            })
            .then(response => response.json())
            .then(data => {
                mostrarCargando(false);
                if (data.success) {
                    if (data.contribuyente) {
                        // Asegurar que el titular tenga un ID único
                        data.contribuyente.id = data.contribuyente.id || Date.now();
                        agregarTitular(data.contribuyente);
                        $('#TitularModal').modal('hide');
                    } else {
                        cambiarAModoRegistrar();
                    }
                } else {
                    mostrarError(data.message || 'Error al buscar titular');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                mostrarCargando(false);
                mostrarError('Error de conexión');
            });
        }

        function registrarTitular() {
            mostrarCargando(true);
            ocultarError();

            const datos = {
                dni: dniInput.value.trim(),
                sexo: sexoInput.value,
                nombre: nombreInput.value.trim(),
                apellido: apellidoInput.value.trim(),
                celular: celularInput.value.trim(),
                correo: correoInput.value.trim(),
                domicilio: domicilioInput.value.trim()
            };

            fetch('/ContratoConcesion/RegistrarContribuyente', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify(datos)
            })
            .then(response => response.json())
            .then(data => {
                mostrarCargando(false);
                if (data.success) {
                    // Asegurar que el titular tenga un ID único
                    data.contribuyente.id = data.contribuyente.id || Date.now();
                    agregarTitular(data.contribuyente);
                    $('#TitularModal').modal('hide');
                } else {
                    mostrarError(data.message || 'Error al registrar titular');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                mostrarCargando(false);
                mostrarError('Error de conexión');
            });
        }

        function agregarTitular(titular) {
            // Normalizo y unifico nombres de propiedades por si vienen con mayúsculas
            const tNorm = {
                id: titular.id ?? titular.Id ?? Date.now(),
                dni: normalizarDni(titular.dni ?? titular.Dni),
                nombre: titular.nombre ?? titular.Nombre ?? '',
                apellido: titular.apellido ?? titular.Apellido ?? '',
                sexo: (titular.sexo ?? titular.Sexo ?? '').toLowerCase(),
                celular: titular.celular ?? titular.Celular ?? '',
                correo: titular.correo ?? titular.Correo ?? titular.correoElectronico ?? titular.CorreoElectronico ?? '',
                domicilio: titular.domicilio ?? titular.Domicilio ?? ''
            };

            // Evitar duplicados aquí también (por si se saltea la validación del modal)
            if (titulares.some(t => normalizarDni(t.dni ?? t.Dni) === tNorm.dni)) {
                mostrarError('Ya existe un titular con este DNI');
                return;
            }

            titulares.push(tNorm);
            renderizarTitulares();
            actualizarContador();
        }

        function eliminarTitular(id) {
            titularAEliminar = id;
            $('#confirmarEliminarModal').modal('show');
        }

        document.getElementById('btnConfirmarEliminar').addEventListener('click', function() {
            if (titularAEliminar !== null) {
                titulares = titulares.filter(t => t.id !== titularAEliminar);
                renderizarTitulares();
                actualizarContador();
                titularAEliminar = null;
                $('#confirmarEliminarModal').modal('hide');
            }
        });

        function renderizarTitulares() {
            contenedorTitulares.innerHTML = '';

            titulares.forEach((titular, index) => {
                const titularDiv = document.createElement('div');
                titularDiv.className = 'titular-item';
                titularDiv.innerHTML = `
                    <div class="titular-header">
                        <span class="titular-number">Titular ${index + 1}</span>
                        <button type="button" class="btn btn-danger btn-sm btn-eliminar" onclick="eliminarTitular(${titular.id})">
                            <i class="bi bi-trash"></i> Eliminar
                        </button>
                    </div>
                    <div class="p-3">
                        <input type="hidden" name="Titulares[${index}].Id" value="${titular.id}" />
                        <div class="form-columns-container3 mb-3">
                            <div>
                                <label>DNI<span class="obligatorio"> * </span></label>
                                <input class="form-control" type="text" name="Titulares[${index}].Dni" value="${titular.dni}" readonly required />
                                <div class="invalid-feedback">El DNI es obligatorio</div>
                            </div>
                            <div>
                                <label>Nombre<span class="obligatorio"> * </span></label>
                                <input class="form-control" type="text" name="Titulares[${index}].Nombre" value="${titular.nombre}" maxlength="60" required />
                                <div class="invalid-feedback">El nombre es obligatorio</div>
                            </div>
                            <div>
                                <label>Apellido<span class="obligatorio"> * </span></label>
                                <input class="form-control" type="text" name="Titulares[${index}].Apellido" value="${titular.apellido}" maxlength="60" required />
                                <div class="invalid-feedback">El apellido es obligatorio</div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label>Domicilio<span class="obligatorio"> * </span></label>
                            <input class="form-control" type="text" name="Titulares[${index}].Domicilio" value="${titular.domicilio}" maxlength="100" required />
                            <div class="invalid-feedback">El domicilio es obligatorio</div>
                        </div>
                        <div class="form-columns-container3">
                            <div>
                                <label>Sexo<span class="obligatorio"> * </span></label>
                                <select class="form-select" name="Titulares[${index}].Sexo" required>
                                    <option value="masculino" ${titular.sexo === 'masculino' ? 'selected' : ''}>Masculino</option>
                                    <option value="femenino" ${titular.sexo === 'femenino' ? 'selected' : ''}>Femenino</option>
                                    <option value="otro" ${titular.sexo === 'otro' ? 'selected' : ''}>Otro</option>
                                </select>
                                <div class="invalid-feedback">El sexo es obligatorio</div>
                            </div>
                            <div>
                                <label>Teléfono</label>
                                <input class="form-control" type="text" name="Titulares[${index}].Celular" value="${titular.celular || ''}" pattern="[0-9]+" maxlength="25" oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                                <div class="invalid-feedback">No puede tener más de 25 dígitos</div>
                            </div>
                            <div>
                                <label>Correo</label>
                                <input class="form-control" type="email" name="Titulares[${index}].CorreoElectronico" value="${titular.correo || ''}" maxlength="100" />
                                <div class="invalid-feedback">Debe contener "@@" y "." </div>
                            </div>
                        </div>
                    </div>
                `;
                contenedorTitulares.appendChild(titularDiv);
            });
        }

        function actualizarContador() {
            contadorTitularesSpan.textContent = titulares.length;
        }

        function cambiarAModoRegistrar() {
            estadoModal = 'registrar';
            camposAdicionales.style.display = 'block';
            btnAccionTitular.textContent = 'Registrar';
            nombreInput.setAttribute('required', '');
            apellidoInput.setAttribute('required', '');
            domicilioInput.setAttribute('required', '');
        }

        function resetearModal() {
            estadoModal = 'buscar';
            formTitular.reset();
            formTitular.classList.remove('was-validated');
            camposAdicionales.style.display = 'none';
            btnAccionTitular.textContent = 'Buscar';
            ocultarError();

            // Remover required de campos
            nombreInput.removeAttribute('required');
            apellidoInput.removeAttribute('required');
            domicilioInput.removeAttribute('required');

            // Limpiar validaciones
            formTitular.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
        }

        // Funciones auxiliares
        function mostrarCargando(mostrar) {
            if (mostrar) {
                btnAccionTitular.disabled = true;
                btnAccionTitular.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Procesando...';
            } else {
                btnAccionTitular.disabled = false;
                btnAccionTitular.textContent = estadoModal === 'buscar' ? 'Buscar' : 'Registrar';
            }
        }

        function mostrarError(mensaje) {
            errorMessage.textContent = mensaje;
            errorMessage.style.display = 'block';
        }

        function ocultarError() {
            errorMessage.style.display = 'none';
        }
    </script>

    <script>//logica de vencimiento
        document.addEventListener('DOMContentLoaded', function() {
            const selectCantidadPrecio = document.getElementById('selectCantidadPrecio');
            const vencimientoConcesion = document.getElementById('vencimientoConcesion');
            const nroConcesion = document.getElementById('nroConcesion');
            const cantidadAniosInputHidden = document.getElementById('cantidadAnios');

            // Función para extraer los años del texto de la opción
            function extraerAnios(textoOpcion) {
                // Usamos una expresión regular para encontrar el número de años
                const match = textoOpcion.match(/^(\d+)\s*años/);
                if (match && match[1]) {
                    return parseInt(match[1]);
                }
                return 0;
            }

            // Función para calcular la fecha de vencimiento
            function calcularVencimiento() {
                if (selectCantidadPrecio.value === "") {
                    alert("Por favor, seleccione la cantidad de años.");
                    return;
                }

                // Obtenemos la opción seleccionada
                const opcionSeleccionada = selectCantidadPrecio.options[selectCantidadPrecio.selectedIndex];

                // Extraemos los años del texto de la opción
                const anios = extraerAnios(opcionSeleccionada.text);

                if (anios === 0) {
                    alert("No se pudo determinar la cantidad de años.");
                    return;
                }

                // Obtenemos la fecha actual
                const hoy = new Date();

                // Creamos una nueva fecha sumando los años
                const nuevaFecha = new Date(hoy);
                nuevaFecha.setFullYear(nuevaFecha.getFullYear() + anios);

                // Formateamos la fecha para el input type="date" (YYYY-MM-DD)
                const year = nuevaFecha.getFullYear();
                const month = String(nuevaFecha.getMonth() + 1).padStart(2, '0');
                const day = String(nuevaFecha.getDate()).padStart(2, '0');
                const fechaFormateada = `${year}-${month}-${day}`;

                // Asignamos la fecha al campo de vencimiento
                vencimientoConcesion.value = fechaFormateada;
                cantidadAniosInputHidden.value = anios; // Actualizamos el input hidden

                
            }


            // También podemos mantener el evento change para el select
            selectCantidadPrecio.addEventListener('change', function() {
                // Solo calcular si hay una selección válida
                if (this.value !== "") {
                    calcularVencimiento();
                } else {
                    vencimientoConcesion.value = "";
                }
            });
        });
    </script>
}